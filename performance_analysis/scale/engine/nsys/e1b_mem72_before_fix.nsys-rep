        color: "#AAAA11"
      - name: L2 Sector Hit Rate
        id: LTS.TriageCompute.lts__average_t_sector_hit_rate_realtime
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: "#AA4444"
      - name: L2 Sector Hit Rate from L1
        id: LTS.TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_realtime
        subMetrics:
