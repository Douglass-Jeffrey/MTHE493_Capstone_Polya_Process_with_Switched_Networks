        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D18841"
      - name: VAF Throughput
        id: TPC.TriageAC.vaf__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D13341"
      - name: L2 Throughput
        id: LTS.TriageAC.lts__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#00AEDB"
      - name: VRAM Throughput
        id: FBSP.TriageAC.dramc__throughput
