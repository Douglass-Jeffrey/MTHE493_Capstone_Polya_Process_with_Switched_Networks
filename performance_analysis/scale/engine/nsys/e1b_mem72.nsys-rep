    schedulingHints:
      - domain: gpu_sm_b
        counters:
          - 0x429f51824686c32f
          - 0x5405725d0bccb9f2
          - 0xc83feae1569676cb
          - 0xf4f29376cc3d2819
      - domain: gpu_sm_c
        counters:
          - 0x072dfe5865d3d982
          - 0x3388ca3182975dbc
          - 0x7f3ce2c9a5d9e8f8
          - 0xff12a10aead6b65b
    metricGroups:
      - name: $root:Activity
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: $root:Memory
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GR Active
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GR Kernel Launch
        metrics:
          - GR Kernel Launch
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GR Context Switches
        metrics:
          - GR Context Switches
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: FE Active
        metrics:
          - FE Active
          - FE Stalled
          - FE Output Ops
          - FE Go Idle
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Async Compute Queue
        metrics:
          - Semaphore Releases Async
          - Semaphore Acquire Stalled Async
          - WFI Stalled Async
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Compute Active
        metrics:
          - Async Compute Active
          - Sync Compute Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SMs Active
        metrics:
          - SMs Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Throughput
        metrics:
          - SM Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Thread Instructions Executed
        metrics:
          - SM Thread Instructions Executed
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Warp Stalls
        metrics:
          - SM Warps Stalled on L1 Operation
          - SM Warps Stalled on MIO Operation
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Instruction Throughputs
        metrics:
          - SM Issue Active
          - SM ALU Pipe Throughput
          - SM FMA Pipe Throughput
          - SM FMA Light Pipe Throughput
          - SM FMA Heavy Pipe Throughput
          - SM Uniform Pipe Throughput
          - SM XU Pipe Throughput
          - SM FP64 Pipe Active
          - SM Tensor Pipe Active
          - SM Tensor Pipe Active FP64
          - SM Tensor Pipe Active (HMMA ops)
          - SM Tensor Pipe Active (IMMA ops)
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Warp Occupancy
        metrics:
          - SM Warps Active
          - SM Warps Active CS
          - Active SM Unused Warp Slots
          - Idle SM Unused Warp Slots
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Shared Memory Usage
        metrics:
          - Shared Memory Available for Compute
          - Shared Memory Allocated for Compute
        subMetrics:
          - Bytes
        aggregationOp: max
      - name: Register Quanta Allocated by Active CS Warps
        metrics:
          - Register Quanta Allocated by Active CS Warps
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Registers per Thread
        metrics:
          - SM Registers per Thread
        subMetrics:
          - Registers
        aggregationOp: max
      - name: SM Thread Blocks Active
        metrics:
          - SM Thread Blocks Active
          - SM Thread Blocks Launched
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Thread Block Average Duration
        metrics:
          - SM Thread Block Average Duration
        subMetrics:
          - Cycles
        aggregationOp: max
      - name: SM Thread Block Average Shared Memory
        metrics:
          - SM Thread Block Average Shared Memory
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: SM Warp Launched CS
        metrics:
          - SM Warp Launched CS
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Thread Block Clusters
        metrics:
          - Clusters Active
          - Clusters Launched
          - Clusters Completed
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 Throughputs
        metrics:
          - L1 Throughput
          - L1 LSU Data-Stage Throughput
          - L1 Local+Global+Distributed Shared Data-Stage Throughput
          - L1 Shared+Attribute Data-Stage Throughput
          - L1 Texture Data-Stage Throughput
          - L1 LSU Writeback-Stage Throughput
          - L1 Local+Global+Distributed Shared Writeback-Stage Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 M-Stage XBAR
        metrics:
          - L1 M-Stage to XBAR Active
          - L1 M-Stage to XBAR Active (Distributed Shared)
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 M-Stage Sectors Read
        metrics:
          - L1 M-Stage Sectors Read
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 Texture Writeback-Stage Throughput
        metrics:
          - L1 Texture Writeback-Stage Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 Sector Hit Rate
        metrics:
          - L1 Sector Hit Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: L1 Sector Requests
        metrics:
          - L1 Sector Requests
          - L1 Sector Requests Hit
          - L1 Sector Requests Missed
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L2 Bandwidths
        metrics:
          - L2 Bandwidth
