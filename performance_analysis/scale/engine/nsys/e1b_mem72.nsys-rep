          - name: GB/s
            suffix: .sum.per_second
            multiplier: 1.2800000000000001e-07
        color: green
      - name: GCC Constant Miss Bandwidth
        id: gcc__cache_requests_type_constant_lookup_miss
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
            multiplier: 64
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 6.4000000000000004e-08
        color: orange
      - name: Sync CTAs launched
        id: gr__ctas_launched_queue_sync_realtime
        subMetrics:
          - name: CTAs/us
            suffix: .sum.per_second
            multiplier: 9.9999999999999995e-07
          - name: CTAs
            suffix: .sum
        color: darkorange
      - name: Async CTAs launched
        id: gr__ctas_launched_queue_async_realtime
        subMetrics:
          - name: CTAs/us
            suffix: .sum.per_second
            multiplier: 9.9999999999999995e-07
          - name: CTAs
            suffix: .sum
        color: orange
      - name: Vertex Shaded Primitives
        id: tpc__input_prims_shader_vs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Prim/GPC
            suffix: .avg
          - name: Primitives
            suffix: .sum
        color: deepskyblue
      - name: VidL2 Sector Hit-Rate from PE Reads
        id: Top_Level_Overview.lts__average_t_sector_hit_rate_srcunit_pe_op_read_realtime
        subMetrics:
          - name: Ratio %
            suffix: .pct
            maxValueSuffix: .max_rate
        color: khaki
      - name: SysL2 Sector Hit-Rate from PE Reads
        id: Top_Level_Overview.syslts__average_t_sector_hit_rate_srcunit_pe_op_read_realtime
        subMetrics:
          - name: Ratio %
            suffix: .pct
            maxValueSuffix: .max_rate
        color: "#B8860B"
      - name: GPC Frequency
        id: gpc__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
          - name: Cycles
            suffix: .avg
        color: olive
      - name: SYS Frequency
        id: sys__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
          - name: Cycles
            suffix: .avg
        color: limegreen
      - name: VidL2 Frequency
        id: lts__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
          - name: Cycles
            suffix: .avg
        color: cyan
      - name: PCIe Read Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_read
        subMetrics:
          - name: Requests/us
            suffix: .sum.per_second
            multiplier: 9.9999999999999995e-07
          - name: Requests
            suffix: .sum
        color: red
      - name: PCIe Write Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_write
        subMetrics:
          - name: Requests/us
            suffix: .sum.per_second
            multiplier: 9.9999999999999995e-07
          - name: Requests
            suffix: .sum
        color: brown
