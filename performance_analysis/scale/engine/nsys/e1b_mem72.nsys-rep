    metricGroups:
      - name: $root:Activity
        metrics:
          - Compute Pipe Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: $root:Memory
        metrics:
          - PCIe Throughput
          - DRAM Total Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: Top-Level Throughput
        description: "Identify which portion of the system is closest to reaching its %-of-peak.\nLow throughput usually indicates a latency-limited workload, or starvation.  First rule out starvation by checking workload launch sizes and warp occupancy.\nHigh throughput is usually good, but there may be speedup opportunities by offloading the highest unit, or reducing its workload.\n"
        metrics:
          - PCIe Throughput
          - DRAM Total Bandwidth
          - SysL2 Throughput
          - VidL2 Throughput
          - SM Throughput
          - L1TEX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe Bandwidth
        description: "Total PCIe bandwidth.\nPCIe is a full-duplex interface.  The RX and TX hard-wires can transfer in parallel.\nGPU Metrics overhead will show up here as background TX traffic.\n"
        metrics:
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: NVLink Bandwidth
        description: "Total NVLink bandwidth.\nNVLink is a full-duplex interface.  The RX and TX hard-wires can transfer in parallel.\n"
        metrics:
          - NVLink RX Bandwidth
          - NVLink TX Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: DRAM Bandwidth
        description: "Total onboard DRAM bandwidth.\nDRAM is a half-duplex interface.  Read and write occur in alternation.\n"
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: SysL2 Throughput
        description: "Observe the SysL2 cache's %-of-peak, and find its top limiters.\nThe SysL2 cache serves SysMem and PeerMem aperture accesses.\n"
        metrics:
          - SysL2 Request Active
          - SysL2-to-XBAR Active
          - XBAR-to-SysL2 Active
          - SysL2 Request Stage Active
          - SysL2 Atomic Stage Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: VidL2 Throughput
        description: "Observe the VidL2 cache's %-of-peak, and find its top limiters.\nThe VidL2 cache serves VidMem aperture accesses, and is connected to the onboard DRAM.\n"
        metrics:
          - VidL2 Sectors
          - VidL2-to-XBAR Active
          - XBAR-to-VidL2 Active
          - VidL2 Request Active
          - VidL2 Atomic Stage Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1TEX Throughput
        description: "Observe the L1TEX cache's %-of-peak, and find its top limiters.\nIf achieved bandwidth is low, but throughput is high, it may imply an inefficient access pattern (lacking coalescing, shared memory bank conflicts, etc.).\n\nThe L1TEX cache has two parallel pipelines:\n‚Ä¢ LSU : local, global, distributed shared, shared memory, shuffle/redux/match/S2R\n‚Ä¢ TC : Tensor Core / UTCMMA wavefronts\n\nCache Fills and XBAR traffic contend with LSU and TC.\n\nThe 336KB of on-chip RAM per SM is composed of 3 SRAMs (128KB + 128KB + 80KB) represented by 2 virtual subbanks (128KB + 208KB).\nShared memory can span 0‚Äì328KB, while tagged cache memory occupies the upper portion of the RAM depending on configuration; in the 328KB SHM mode, only 8KB of tagged L1 remains.\n"
        metrics:
          - L1TEX LSU Data-Stage Throughput
          - L1TEX LSU Writeback-Stage Throughput
          - L1TEX TC Data-Stage Throughput
          - XBAR-to-L1TEX Read Sectors
          - XBAR-to-L1TEX DSMEM Read Sectors
          - L1TEX-to-XBAR Requests Active
          - L1TEX-to-XBAR DSMEM Requests Active
          - L1TEX-to-XBAR TMA Requests Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Throughput
        description: "Observe the shader cores' %-of-peak for instruction issue and math performance.\n‚Ä¢ Issue Stage covers all operations.\n‚Ä¢ ALUHeavy covers INT32, except for integer multiply and dot-product.\n‚Ä¢ FMA covers integer multiply, dot-product, scalar and packed FP16/FP32 ops.\n‚Ä¢ XU is the special function unit, for reciprocals, square-roots, and transcendentals.\n‚Ä¢ Tensor performs CUDA HMMA, DMMA, IMMA.\n‚Ä¢ Uniform performs warp-level scalar operations.\n"
        metrics:
          - SM Issue Stage Throughput
          - SM ALU Pipe Throughput
          - SM FMA Pipe Throughput
          - SM XU Pipe Throughput
          - SM Tensor Pipe Throughput
          - SM Tensor Pipe Throughput (HMMA)
          - SM Tensor Pipe Throughput (DMMA)
          - SM Uniform Pipe Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Memory Bandwidth
        description: "Observe the bandwidth from the SM to each shader memory space.\nEvery item in this row is generated (directly or indirectly) by shaders or CUDA kernels.\nThe metrics in this row are overlaid to show the absolute magnitude; however, this disregards pipeline or bus sharing.  See additional L1TEX Throughput and Bandwidth rows to understand those types of limiters.\n"
        metrics:
          - L1TEX Tag-Stage Bandwidth
          - L1TEX LSU Data-Stage Throughput
          - L1TEX TC Data-Stage Throughput
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: L1TEX LSU Throughput
        description: "Observe the Load/Store Unit's %-of-peak, and find its top limiters.\nIf LSU Data > LSU Writeback, it's likely poor address coalescing (local / global), or high bank conflicts (shared).\nIf LSU Writeback > LSU Data, it's likely due to 64-bit or 128-bit uniform loads.\n"
        metrics:
          - L1TEX LSU Data-Stage Throughput
          - L1TEX LSU Writeback-Stage Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1TEX LSU Throughput per Memory Space
        description: "Determine the main contributor to high LSU throughput.\nLocal memory is used by indexed per-thread arrays, and compiler spills when out-of-registers.\nGlobal memory corresponds to certain types of buffers, like byte addressed buffers.\nShared memory is groupshared in HLSL, or 'shared\" in GLSL.\nWave Intrinsics include shuffles and warp-level reductions.\n"
        metrics:
          - L1TEX Local+Global Data-Stage Throughput
          - L1TEX Shared+Attribute Data-Stage Throughput
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: Local/Global Bandwidth
        description: "Bandwidth requests to \"tagged\" memory spaces that reside in main memory.\nIncludes local and global memory accesses.\nDoes not include shared memory.\n"
        metrics:
          - L1TEX Tag-Stage Bandwidth
          - L1TEX Tag-Stage Bandwidth (miss)
          - VidL2 Total from L1TEX
          - VidL2 Misses from L1TEX
          - SysL2 Bandwidth from L1TEX
          - SysL2 Misses from L1TEX
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: L1TEX Tag-Stage Bandwidth per Hit/Miss
        description: "Bandwidth requests to \"tagged\" data memory spaces that reside in main memory, decomposed into hit and miss bandwidth.\nTagged data memory includes local and global memory accesses.\nRequests to untagged memory always count as misses.\n"
        metrics:
          - L1TEX Tag-Stage Bandwidth (hit)
          - L1TEX Tag-Stage Bandwidth (miss)
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: L1TEX Sector Hit-Rate
        description: "This row shows the aggregate hit-rate.  Note that atomics always miss in L1TEX (0% hit-rate), and are therefore not shown here.\n"
        metrics:
          - L1TEX Hit-Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: L2 Sector Hit-Rate from L1TEX
        description: "If the hit-rates in this row are low, it means data accesses are missing in both the L1TEX cache and the L2 cache.  These accesses will pay the full latency penalty of a main memory access (to system memory or video memory).\n"
        metrics:
          - VidL2 Sector Hit-Rate from L1TEX Reads
          - VidL2 Sector Hit-Rate from L1TEX Writes
          - VidL2 Sector Hit-Rate from L1TEX Atomics
          - SysL2 Sector Hit-Rate from L1TEX Reads
          - SysL2 Sector Hit-Rate from L1TEX Writes
          - SysL2 Sector Hit-Rate from L1TEX Atomics
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: Constant Memory Bandwidth
        description: "See also: the GCC Bandwidth row for the total GCC and L2 bandwidth impact.\n"
        metrics:
          - GCC Constant Bandwidth
          - GCC Constant Miss Bandwidth
          - GCC Constant Tag Hit Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: Constant Cache Hit-Rates
        metrics:
          - GCC Constant Hit-Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: Instruction Memory Bandwidth
        description: "See also: the GCC Bandwidth row for the total GCC and L2 bandwidth impact.\n"
        metrics:
          - GCC Inst Bandwidth
          - GCC Inst Miss Bandwidth
          - GCC Instruction Tag Hit Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: Instruction Cache Hit-Rates
        metrics:
          - GCC Inst Hit-Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: GCC Bandwidth
        description: "The GCC is a mid-level cache for constant and instruction descriptor memory.  It sits between the corresponding L1 caches (DCC, IDC, ICC, TSL1) and the L2 cache(s).\nThis row shows the overall bandwidth for these memory spaces, and the flow through the cache hierarchy.\n"
        metrics:
          - GCC Bandwidth
          - GCC Miss Bandwidth
          - VidL2 Bandwidth from GCC
          - VidL2 Sector Misses from GCC
          - SysL2 Bandwidth from GCC
          - SysL2 Sector Misses from GCC
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: GCC Bandwidth per Type
        description: "The GCC Constant Cache's bandwidth is proportional to miss-traffic from various L1 caches in the SMs.\n[128-bytes / cycle] Instruction requests come from the SM L1I$, aka ICC.\n[  64-bytes / cycle] Constant requests come from the DCC (scalar constant cache) or IDC (indexed constant cache).\n"
        metrics:
          - GCC Inst Bandwidth
          - GCC Constant Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: GCC Hit-Rates
        description: "Observe the hit-rate of each memory space served by the GCC cache:\nIf low instruction hit-rate: consider reducing loop unrolling or force-no-inline.\nIf low constant hit-rate: consider compacting data into 64B or 256B aligned regions (cache & prefetch-friendly), and reducing indexed constant loads.\n"
        metrics:
          - GCC Inst Hit-Rate
          - GCC Constant Hit-Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: GCC Tag-Stage Miss-Bandwidth per Type
        description: "The approximate miss bandwidth from GCC to L2.\nThis row shows tag misses, not true misses.\n"
        metrics:
          - GCC Inst Miss Bandwidth
          - GCC Constant Miss Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: Compute Engine
        description: "Indicates whether a compute dispatch is in the pipeline.\nA dispatch that was started, but hasn't yet launched a thread block, will be counted here.\nDispatches may be queued for a long time before launching their first thread block.\n"
        metrics:
          - Compute Pipe Active
        subMetrics:
          - Throughput %
          - Cycles
        aggregationOp: max
      - name: Thread Blocks Launched
        description: "Observe thread blocks launched from CWD or preloaded thread blocks received new WorkID.\n"
        metrics:
          - Thread Blocks Launched from CWD
          - WorkIDs Granted as Thread Blocks
        subMetrics:
          - Blocks/us
          - Blocks
        aggregationOp: sum
      - name: GR Kernel Launch
        description: "Observe the number of compute dispatches sent to GR.\n"
        metrics:
          - Kernel Launched
        subMetrics:
          - Dispatches
        aggregationOp: max
      - name: GR Context Switches
        description: "Observe the cycles where GR performed a context switch.\n"
        metrics:
          - GR Context Switch
        subMetrics:
          - Cycles
        aggregationOp: max
      - name: Sync Compute Q Engine Activity
        description: "Observe when the Sync Q is active processing a command.\n"
        metrics:
          - Sync Compute in Flight
        subMetrics:
          - Throughput %
          - Cycles
        aggregationOp: max
      - name: Sync Compute Q Semaphore Releases
        description: "Release of a hardware semaphore value in memory.\n"
        metrics:
          - Sync Queue Semaphore Releases
        subMetrics:
          - Total
        aggregationOp: max
      - name: Sync Compute Q Waiting
        description: "Observe when the Sync Q is waiting on work completion at the FrontEnd stage.  While a queue is waiting in this way, it will not issue any further commands to GPU engines.\n"
        metrics:
          - Sync Wait For Idle
        subMetrics:
          - Throughput %
          - Cycles
        aggregationOp: max
      - name: Sync Compute Q GPFIFO Idle
        description: "Observe when the Sync Q is idle due to a lack of pending commands.\n"
        metrics:
          - Sync GPFIFO Idle
        subMetrics:
          - Throughput %
          - Cycles
        aggregationOp: max
      - name: Async Compute Q Engine Activity
        description: "Observe when the Async Q is active processing a command.\n"
        metrics:
          - Async Compute in Flight
        subMetrics:
          - Throughput %
          - Cycles
        aggregationOp: max
      - name: Async Compute Q Semaphore Releases
        description: "Release of a hardware semaphore value in memory.\n"
        metrics:
          - Async Compute Q Semaphore Releases
        subMetrics:
          - Total
        aggregationOp: max
      - name: Async Compute Q Waiting
        description: "Observe when any Async Compute Q is waiting on work completion at the FrontEnd stage.  While a queue is waiting in this way, it will not issue any further commands to GPU engines.\n"
        metrics:
          - Async Compute Q Wait For Idle
        subMetrics:
          - Throughput %
          - Cycles
        aggregationOp: max
      - name: System Memory
        description: "Bandwidth to the system memory aperture, at the SysL2 Request stage, SysL2 Miss stage, and at the PCIe connection.\n"
        metrics:
          - SysL2 Total Memory Bandwidth
          - SysL2 Miss Bandwidth
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: NVLink RX Bandwidth Breakdown
        description: "Inbound NVLink bandwidth.\nResponses User/Protocol Data metrics indicate when GPU is pulling data from remote memory.\n"
        metrics:
          - NVLink RX User Data
          - NVLink RX Protocol Data
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: NVLink TX Bandwidth Breakdown
        description: "Outbound NVLink bandwidth.\nResponses User/Protocol Data metrics indicate when a remote GPU is reading local data.\n"
        metrics:
          - NVLink TX User Data
          - NVLink TX Protocol Data
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: SysL2 Bandwidth per Destination
        description: "Bandwidth requests to the GPU's SysL2 cache per memory aperture.\nIf a large amount of traffic is going to system memory, consider allocating DRAM buffers, and separately copying results in/out.\n"
        metrics:
          - SysL2-to-SysMem Bandwidth
          - SysL2-to-PeerMem Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: SysL2 Bandwidth per Source Unit
        description: "Bandwidth requests to the GPU's SysL2 cache, broken down by source unit.\nThis row makes it easy to determine which units are missing in their L1 caches, or otherwise generating a large amount of memory traffic.\n"
        metrics:
          - SysL2 Bandwidth from L1TEX
          - SysL2 Bandwidth from GCC
          - SysL2 Bandwidth from CE
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: SysL2 Sector Hit-Rate (Total)
        description: "Use this row to diagnose latency-limited workloads.\n"
        metrics:
          - SysL2 Sector Hit-Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: SysL2 Sector Hit-Rate per Destination
        metrics:
          - SysL2 Sector Hit Rate from PeerMem
          - SysL2 Sector Hit Rate from SysMem
        subMetrics:
          - Ratio %
        aggregationOp: sum
      - name: SysL2 Sector Hit-Rate per Source Unit
        metrics:
          - SysL2 Sector Hit-Rate from L1TEX
          - SysL2 Sector Hit-Rate from GCC
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: SysLRC Throughput
        description: "Indicates whether SysLRC is successfully merging read traffic from system memory.\nWhen multiple GPC/L1TEX read requests target the same cache line within a window, LRC can coalesce them and multicast the response back through XBAR instead of sending duplicate SysL2 traffic.\n‚Ä¢ High Coalesced, low Fragmented ‚Üí multicast/coalescing is working, reducing return-path traffic pressure.\n‚Ä¢ Low Coalesced, high Fragmented ‚Üí reads are mostly uncoalesced, so system memory traffic is less efficient.\n‚Ä¢ Coalesced XBAR-to-GPC much larger than SysLRC-to-XBAR ‚Üí strong coalescing payoff / fanout to multiple GPC consumers.\n"
        metrics:
          - SysLRC-to-XBAR Coalesced Reads
          - SysLRC XBAR-to-GPC Coalesced Reads
          - SysL2-to-SysLRC Fragmented Reads
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: Video Memory
        description: "Bandwidth to the video memory aperture, at the VidL2 Request, VidL2 Miss, and onboard DRAM stages.\nDRAM is a half-duplex interface.  Read and write occur in alternation.\n"
        metrics:
          - DRAM Total Bandwidth
          - VidL2 Miss Bandwidth
          - VidL2 Sectors
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: VidL2 Bandwidth per Source Unit
        description: "Bandwidth requests to the GPU's VidL2 cache, broken down by source unit.\nThis row makes it easy to determine which units are missing in their L1 caches, or otherwise generating a large amount of memory traffic.\n"
        metrics:
          - VidL2 Total from L1TEX
          - VidL2 Bandwidth from GCC
          - VidL2 Bandwidth from CE
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: VidL2 Sector Hit-Rate (Total)
        description: "Use this row to diagnose latency-limited workloads.\n"
        metrics:
          - VidL2 Sector Hit-Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: VidL2 Sector Hit-Rate per Source Unit
        description: "Use this row to diagnose latency-limited workloads.\n"
        metrics:
          - VidL2 Sector Hit-Rate from L1TEX
          - VidL2 Sector Hit-Rate from GCC
          - VidL2 Sector Hit-Rate from CE
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: VidLRC Throughput
        description: "Indicates whether VidLRC is successfully merging read traffic from video memory.\nWhen multiple GPC/L1TEX read requests target the same cache line within a window, LRC can coalesce them and multicast the response back through XBAR instead of sending duplicate VidL2 traffic.\n‚Ä¢ High Coalesced, low Fragmented ‚Üí VidLRC coalescing/multicast is working, reducing VidL2 return-path traffic pressure.\n‚Ä¢ Low Coalesced, high Fragmented ‚Üí reads are mostly uncoalesced, so video memory traffic is less efficient.\n‚Ä¢ Coalesced XBAR-to-GPC much larger than VidLRC-to-XBAR ‚Üí strong coalescing payoff / fanout to multiple GPC consumers.\n"
        metrics:
          - VidLRC-to-XBAR Coalesced Reads
          - VidLRC XBAR-to-GPC Coalesced Reads
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: Warp Latency
        description: "Warp Latency estimates the average lifespan of a warp (in cycles), over a span of time in which the SMs were active. \nThus, it appears as a constant value across each compute execution region.  It's an absolute measure of kernel performance, and is comparable from run-to-run.\nThe boundaries of each compute execution region are determined by periods of no or low kernel activity.\n"
        metrics:
          - Compute Warp Latency
        subMetrics:
          - Cycles
        aggregationOp: max
      - name: SM Warps Launched
        description: "Indicates when compute warps were launched onto SMs.\n"
        metrics:
          - Compute Warps Launched
        subMetrics:
          - Warps/us
          - Warps
        aggregationOp: max
      - name: SM Warp Stalls
        description: "Indicates the % of warps that are waiting on each latency reason.\n‚Ä¢ Short scoreboard : L1TEX operations (local, global)\n‚Ä¢ Long scoreboard : MIO operations other than (local, global)\n"
        metrics:
          - Stalled on Short Scoreboard
          - Stalled on Long Scoreboard
        subMetrics:
          - Warps/SM
          - Occupancy %
        aggregationOp: sum
      - name: Active Threads per Warp
        description: "Low % predicated-on threads implies poor math pipe utilization.\n"
        metrics:
          - Predicated-on Active Threads per Warp
        subMetrics:
          - Threads/Warp
          - Coherence
        aggregationOp: max
      - name: SM Tensor Pipe Instructions per Family
        description: "Observe which type of output Tensor Instructions generate.\n"
        metrics:
          - SM Tensor Pipe Throughput (DMMA)
          - SM Tensor Pipe Throughput (HMMA)
        subMetrics:
          - Throughput %
          - Cycles
        aggregationOp: sum
      - name: SM Tensor Memory Throughput
        metrics:
          - SM Tensor Memory Throughtput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Tensor Memory Allocation
        metrics:
          - SM Thread Block Tensor Memory
        subMetrics:
          - Bytes/SM
        aggregationOp: max
      - name: SM Thread Block Average Shared Memory
        metrics:
          - SM Avg Thread Block Shared Memory
        subMetrics:
          - kB
        aggregationOp: max
      - name: SM Registers per Thread
        metrics:
          - SM Avg Registers per Thread
        subMetrics:
          - Registers
        aggregationOp: max
      - name: Thread Block Clusters
        description: "Observe Thread Block Clusters activity.\nLarger clusters reduce placement flexibility and often hurt concurrency/throughput.\n‚Ä¢ Low Launched and low Active indicate launch/dispatch starvation.\n‚Ä¢ High Launched and low Active indicate short-lived clusters or weak residency.\n‚Ä¢ High Active and low Completed indicates long-lived or stalled clusters; look downstream at SM, memory, barriers, DSMEM.\n"
        metrics:
          - Thread Block Clusters Launched
          - Thread Block Clusters Active
          - Thread Block Clusters Completed
        subMetrics:
          - Clusters
        aggregationOp: max
      - name: SM Warp Occupancy
        description: "The number of occupied warp slots, on average.\nDo not worry about warp occupancy unless SM Instruction Throughput is low.  Increasing warp occupancy is one way to improve the issue rate, but there are other ways as well (increasing intra-warp arithmetic intensity, reducing long latency operations).\nFewer than 4 warps on an SM is a starvation condition; launch bigger workloads.\nHigher is not always better.  16 warps/SM is enough to fully hide math pipe latency.\nUnused slots on Active SMs usually imply that an occupancy limiter was reached.\n"
        metrics:
          - SM Warps Active
          - Unallocated Warps in Active SMs
        subMetrics:
          - Warps/SM
          - Occupancy %
        aggregationOp: sum
      - name: SM Register Occupancy
        description: "Each SM subpartition has a register file with 16K √ó 4Byte registers.\nEach warp allocates registers in chunks of 8 registers/thread √ó 32 threads/warp = 256 registers.\n"
        metrics:
          - CS Register Allocation
        subMetrics:
          - Occupancy %
          - Registers/SM
        aggregationOp: sum
      - name: SM Thread Block Occupancy
        description: "At most, 16 thread blocks can be resident on a single SM at any given time.\n"
        metrics:
          - SM Thread Blocks Allocated
        subMetrics:
          - Throughput %
          - Avg Blocks/SM
        aggregationOp: max
      - name: L1TEX Data Occupancy
        description: "This row shows the partitioning of the 336KB on-chip memory per SM into shared memory and tagged cache memory.\n‚Ä¢ When compute shaders are running, a partition is dynamically created for shared memory. When this partition is full, compute warp launches will stall.\n‚Ä¢ The remainder - tagged cache - serves local and global memory accesses.\n"
        metrics:
          - SM Shared Memory Allocated
          - SM Shared Memory Unallocated
          - SM Tagged Memory
        subMetrics:
          - Bytes/SM
        aggregationOp: sum
      - name: L1TEX Cache Bytes per Warp
        description: "Average cache bytes per warp\n"
        metrics:
          - SM Avg L1TEX Cache Bytes per Warp
        subMetrics:
          - kB
        aggregationOp: max
      - name: Clock Frequencies
        description: "The GPU is divided into many clock domains; this row shows their frequencies over time.\n"
        metrics:
          - GPC Frequency
          - SYS Frequency
          - VidL2 Frequency
          - DRAM Frequency
        subMetrics:
          - MHz
          - Cycles
        aggregationOp: max
    timelineViews:
      - name: Default
        rows:
          - metricGroup: $root:Activity
            heightScale: 0.5
          - metricGroup: $root:Memory
            heightScale: -0.5
          - metricGroup: Top-Level Throughput
            heightScale: 2
            children:
              - PCIe Bandwidth
              - NVLink Bandwidth
              - metricGroup: DRAM Bandwidth
              - SysL2 Throughput
              - VidL2 Throughput
              - L1TEX Throughput
              - SM Throughput
          - metricGroup: SM Memory Bandwidth
            children:
              - metricGroup: L1TEX Throughput
                children:
                  - L1TEX LSU Throughput
                  - metricGroup: L1TEX LSU Throughput per Memory Space
              - metricGroup: Local/Global Bandwidth
                children:
                  - metricGroup: L1TEX Tag-Stage Bandwidth per Hit/Miss
                  - L1TEX Sector Hit-Rate
                  - L2 Sector Hit-Rate from L1TEX
              - metricGroup: Constant Memory Bandwidth
                children:
                  - Constant Cache Hit-Rates
              - metricGroup: Instruction Memory Bandwidth
                children:
                  - Instruction Cache Hit-Rates
              - metricGroup: GCC Bandwidth
                children:
                  - metricGroup: GCC Bandwidth per Type
                  - GCC Hit-Rates
                  - metricGroup: GCC Tag-Stage Miss-Bandwidth per Type
          - metricGroup: Compute Engine
            children:
              - metricGroup: Thread Blocks Launched
              - GR Kernel Launch
              - GR Context Switches
          - metricGroup: Sync Compute Q Engine Activity
            children:
              - Sync Compute Q Semaphore Releases
              - Sync Compute Q Waiting
              - Sync Compute Q GPFIFO Idle
          - metricGroup: Async Compute Q Engine Activity
            children:
              - Async Compute Q Semaphore Releases
              - Async Compute Q Waiting
          - metricGroup: System Memory
            children:
              - metricGroup: NVLink Bandwidth
                children:
                  - metricGroup: NVLink RX Bandwidth Breakdown
                  - metricGroup: NVLink TX Bandwidth Breakdown
              - PCIe Bandwidth
              - metricGroup: SysL2 Bandwidth per Destination
              - metricGroup: SysL2 Bandwidth per Source Unit
              - SysL2 Sector Hit-Rate (Total)
              - metricGroup: SysL2 Sector Hit-Rate per Destination
              - SysL2 Sector Hit-Rate per Source Unit
              - SysL2 Throughput
              - SysLRC Throughput
          - metricGroup: Video Memory
            children:
              - metricGroup: DRAM Bandwidth
              - metricGroup: VidL2 Bandwidth per Source Unit
              - VidL2 Sector Hit-Rate (Total)
              - VidL2 Sector Hit-Rate per Source Unit
              - VidL2 Throughput
              - VidLRC Throughput
          - metricGroup: Warp Latency
            children:
              - SM Warps Launched
              - metricGroup: SM Warp Stalls
          - metricGroup: SM Throughput
            children:
              - Active Threads per Warp
              - metricGroup: SM Tensor Pipe Instructions per Family
              - SM Tensor Memory Throughput
              - SM Tensor Memory Allocation
              - SM Thread Block Average Shared Memory
              - SM Registers per Thread
              - Thread Block Clusters
          - metricGroup: SM Warp Occupancy
            children:
              - metricGroup: SM Register Occupancy
              - SM Thread Block Occupancy
              - metricGroup: L1TEX Data Occupancy
                children:
                  - L1TEX Cache Bytes per Warp
          - metricGroup: Clock Frequencies
            drawStyle: line
  - name: Graphics Throughput Metrics for NVIDIA TU10x
    alias: tu10x-gfxt
    chips:
      - TU102
      - TU104
      - TU106
    setSpecifier: Default
    metrics:
      - name: GPU Active
        id: FE_A.TriageA.gpu__engine_cycles_active_gr_or_ce
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Cycles Active
            suffix: .sum
        color: "#33B2B2"
      - name: Sync Copy Engine Active
        id: FE_A.TriageA.gpu__engine_cycles_active_any_syncce
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Cycles Active
            suffix: .sum
        color: "#B2B233"
      - name: Async Copy Engine Active
        id: FE_A.TriageA.gpu__engine_cycles_active_any_asyncce
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Cycles Active
            suffix: .sum
        color: "#FFA700"
      - name: GR Active
        id: FE_A.TriageA.gr__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Cycles Active
            suffix: .sum
        description: Number of cycles the graphics/compute engine is active. The graphics and compute engine are active if there is any work in the graphics pipe or if the compute pipe is processing a dispatch.
        color: "#ED6A32"
      - name: SM Throughput
        id: SM.TriageA.sm__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D100EE"
      - name: RTCORE Throughput
        id: rtcore__cycles_executed
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D18841"
      - name: VAF Throughput
        id: TPC.TriageA.vaf__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D13341"
      - name: L1 Throughput
        id: SM.TriageA.l1tex__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FFC425"
      - name: L2 Throughput
        id: LTS.TriageA.lts__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#00AEDB"
      - name: VRAM Throughput
        id: FBPA.TriageA.dramc__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#F37735"
      - name: PCIe Throughput
        id: PCI.TriageA.pcie__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#3577F3"
      - name: PD Throughput
        id: HUB.TriageA.pda__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#00B159"
      - name: PES+VPC Throughput
        id: GPC_B.TriageA.pes__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#3FB159"
      - name: RASTER Throughput
        id: GPC_A.TriageA.raster__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#6FB159"
      - name: PROP Throughput
        id: GPC_A.TriageA.prop__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#9FB159"
      - name: ZROP Throughput
        id: ROP.TriageA.zrop__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#854442"
      - name: CROP Throughput
        id: ROP.TriageA.crop__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#AFB159"
      - name: Sync Compute in Flight
        id: HUB.TriageA.gr__dispatch_cycles_active_queue_sync
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FE7F9C"
      - name: Async Compute in Flight
        id: HUB.TriageA.gr__dispatch_cycles_active_queue_async
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FFD179"
      - name: Draw Started
        id: FE_A.TriageA.fe__draw_count
        subMetrics:
          - name: Workloads
            suffix: .sum
        description: Number of draw calls started
        color: "#F0F000"
      - name: Dispatch Started
        id: HUB.TriageA.gr__dispatch_count
        subMetrics:
          - name: Workloads
            suffix: .sum
        description: Number of compute dispatches/grid launches started
        color: "#00F0F0"
      - name: Vertex/Tess/Geometry Warps
        id: TPC.TriageA.tpc__warps_active_shader_vtg_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        color: "#0057E7"
      - name: Pixel Warps
        id: TPC.TriageA.tpc__warps_active_shader_ps_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        color: "#008744"
      - name: Compute Warps
        id: TPC.TriageA.tpc__warps_active_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        color: "#FFA700"
      - name: Unallocated Warps in Active SMs
        id: TPC.TriageA.tpc__warps_inactive_sm_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        color: "#696969"
      - name: Idle SM Unused Warp Slots
        id: TPC.TriageA.tpc__warps_inactive_sm_idle_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        color: "#C0C0C0"
      - name: PS Warp Can't Launch
        id: tpc__warp_launch_cycles_stalled_shader_ps
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FF6F00"
      - name: PS Warp Can't Launch - Register Limited
        id: tpc__warp_launch_cycles_stalled_shader_ps_reason_register_allocation
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#00CF00"
      - name: CS Warp Can't Launch - Register Limited
        id: tpc__warp_launch_cycles_stalled_shader_cs_reason_register_allocation
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#1111CF"
      - name: SM Issue Active
        id: SM.TriageA.sm__inst_executed_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Instructions
            suffix: .sum
          - name: Avg Inst/Clk per SM
            suffix: .avg.per_cycle_elapsed
          - name: Peak Inst/Clk per SM
            suffix: .avg.peak_sustained
        description: SM instruction issue rate. Each SM can issue 4 instructions/cycle (1 instruction/SMSP/cycle).
        color: "#CFCF3F"
      - name: SM ALU Pipe Throughput
        id: SM.TriageA.sm__inst_executed_pipe_alu_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Instructions
            suffix: .sum
          - name: Avg Inst/Clk per SM
            suffix: .avg.per_cycle_elapsed
          - name: Peak Inst/Clk per SM
            suffix: .avg.peak_sustained
        color: "#FF6F00"
      - name: SM FMA Pipe Throughput
        id: SM.TriageA.sm__inst_executed_pipe_fma_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Instructions
            suffix: .sum
          - name: Avg Inst/Clk per SM
            suffix: .avg.per_cycle_elapsed
          - name: Peak Inst/Clk per SM
            suffix: .avg.peak_sustained
        color: "#00CF3F"
      - name: SM SFU Pipe Throughput
        id: SM.TriageA.sm__inst_executed_pipe_xu_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Instructions
            suffix: .sum
          - name: Avg Inst/Clk per SM
            suffix: .avg.per_cycle_elapsed
          - name: Peak Inst/Clk per SM
            suffix: .avg.peak_sustained
        color: "#00003F"
      - name: SM FP16+Tensor Pipe Throughput
        id: SM.TriageA.sm__pipe_shared_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Instructions
            suffix: .sum
          - name: Avg Inst/Clk per SM
            suffix: .avg.per_cycle_elapsed
          - name: Peak Inst/Clk per SM
            suffix: .avg.peak_sustained
        description: Cycles the tensor pipe or fp16x2 pipe is active
        color: "#CF003F"
      - name: L1 LSU Data-Stage Throughput
        id: SM.TriageA.l1tex__data_pipe_lsu_wavefronts
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#CFCF3F"
      - name: L1 Texture Data-Stage Throughput
        id: SM.TriageA.l1tex__data_pipe_tex_wavefronts_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#00003F"
      - name: L1 LSU Writeback-Stage Throughput
        id: SM.TriageA.l1tex__lsu_writeback_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#CF003F"
      - name: L1 Texture Filter-Stage Throughput
        id: SM.TriageA.l1tex__f_cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#3F00CF"
      - name: L2 Bandwidth from CROP
        id: TriageA.lts__t_sector_throughput_srcunit_crop
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#AA1111"
      - name: L2 Bandwidth from L1
        id: TriageA.lts__t_sector_throughput_srcunit_tex
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#11AA11"
      - name: L2 Bandwidth from ZROP
        id: TriageA.lts__t_sector_throughput_srcunit_zrop
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#1111AA"
      - name: L2 Hit Rate
        id: LTS.TriageA.lts__average_t_sector_op_read_realtime_hit_rate
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: "#88001B"
      - name: L2 Hit Rate from L1
        id: LTS.TriageA.lts__average_t_sector_srcunit_tex_op_read_realtime_hit_rate
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: "#FFCA18"
      - name: GPU Memory Read Bandwidth
        id: FBPA.TriageA.dramc__read_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#CCCC00"
      - name: GPU Memory Write Bandwidth
        id: FBPA.TriageA.dramc__write_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#CC00CC"
      - name: PCIe Read Bandwidth
        id: PCI.TriageA.pcie__read_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 1.0000000000000001e-09
        description: Number of bytes received by GPU (includes protocol)
        color: "#FF3D00"
      - name: PCIe Write Bandwidth
        id: PCI.TriageA.pcie__write_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 1.0000000000000001e-09
        description: Number of bytes transmitted by GPU (includes protocol)
        color: "#00CFCF"
      - name: PCIe Read Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_read
        subMetrics:
          - name: Requests
            suffix: .sum
        description: CPU+Peer Reads from VRAM over PCIe
        color: "#87FFFF"
      - name: PCIe Write Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_write
        subMetrics:
          - name: Requests
            suffix: .sum
        description: CPU+Peer Writes to VRAM over PCIe
        color: "#8700FF"
      - name: PCIe Read Requests to BAR0
        id: pcie__rx_requests_aperture_bar0_op_read
        subMetrics:
          - name: Requests
            suffix: .sum
        color: "#AFFF87"
      - name: PCIe Write Requests to BAR0
        id: pcie__rx_requests_aperture_bar0_op_write
        subMetrics:
          - name: Requests
            suffix: .sum
        color: "#870087"
      - name: PCIe Read Requests to BAR2
        id: pcie__rx_requests_aperture_bar2_op_read
        subMetrics:
          - name: Requests
            suffix: .sum
        color: "#AFAF00"
      - name: PCIe Write Requests to BAR2
        id: pcie__rx_requests_aperture_bar2_op_write
        subMetrics:
          - name: Requests
            suffix: .sum
        color: "#870000"
      - name: ZCULL Rejected Samples
        id: GPC_A.TriageA.raster__zcull_input_samples_op_rejected_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Sum
            suffix: .sum
        color: "#663399"
      - name: ZCULL Input Samples
        id: GPC_A.TriageA.raster__zcull_input_samples_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Sum
            suffix: .sum
        color: "#CC3399"
    metricGroups:
      - name: $root:Activity
        metrics:
          - GPU Active
          - Async Copy Engine Active
          - Sync Copy Engine Active
          - GR Active
        subMetrics:
          - Throughput %
          - Cycles Active
        aggregationOp: max
      - name: $root:Memory
        metrics:
          - GPU Memory Read Bandwidth
          - GPU Memory Write Bandwidth
          - PCIe Read Bandwidth
          - PCIe Write Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: GPU Active
        description: The graphics or copy engine is active
        metrics:
          - GPU Active
          - Sync Copy Engine Active
          - Async Copy Engine Active
          - GR Active
        subMetrics:
          - Throughput %
          - Cycles Active
        aggregationOp: max
      - name: Unit Throughputs
        description: Throughput of each major hardware unit
        metrics:
          - SM Throughput
          - RTCORE Throughput
          - VAF Throughput
          - L1 Throughput
          - L2 Throughput
          - VRAM Throughput
          - PCIe Throughput
          - PD Throughput
          - PES+VPC Throughput
          - RASTER Throughput
          - PROP Throughput
          - ZROP Throughput
          - CROP Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Compute in Flight
        description: Compute dispatches sent to the GPU queues that have been issued, but not yet complete
        metrics:
          - Sync Compute in Flight
          - Async Compute in Flight
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Draw/Dispatch Start
        description: Draw and dispatch start times
        metrics:
          - Draw Started
          - Dispatch Started
        subMetrics:
          - Workloads
        aggregationOp: max
      - name: SM Occupancy (TPC View)
        metrics:
          - Vertex/Tess/Geometry Warps
          - Pixel Warps
          - Compute Warps
          - Unallocated Warps in Active SMs
          - Idle SM Unused Warp Slots
        subMetrics:
          - Throughput %
          - Avg
          - Avg Warps per Cycle
        aggregationOp: sum
      - name: Warp Can't Launch
        description: Warp can't launch reasons
        metrics:
          - PS Warp Can't Launch
          - PS Warp Can't Launch - Register Limited
          - CS Warp Can't Launch - Register Limited
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Instruction Throughputs
        description: SM instruction throughput breakdown by pipe
        metrics:
          - SM Issue Active
          - SM ALU Pipe Throughput
          - SM FMA Pipe Throughput
          - SM SFU Pipe Throughput
          - SM FP16+Tensor Pipe Throughput
        subMetrics:
          - Throughput %
          - Instructions
          - Avg Inst/Clk per SM
          - Peak Inst/Clk per SM
        aggregationOp: max
      - name: L1 Throughputs
        description: L1 cache throughputs breakdown by stage
        metrics:
          - L1 LSU Data-Stage Throughput
          - L1 Texture Data-Stage Throughput
          - L1 LSU Writeback-Stage Throughput
          - L1 Texture Filter-Stage Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L2 Bandwidth
        description: L2 bandwidth breakdown by source unit
        metrics:
          - L2 Bandwidth from CROP
          - L2 Bandwidth from L1
          - L2 Bandwidth from ZROP
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: L2 Hit Rates
        description: L2 cache hit rates in aggregate and for read operations from L1
        metrics:
          - L2 Hit Rate
          - L2 Hit Rate from L1
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: GPU Memory Bandwidth
        description: GPU memory read/write bandwidth
        metrics:
          - GPU Memory Read Bandwidth
          - GPU Memory Write Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: PCIe RX Bandwidth
        metrics:
          - PCIe Read Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: PCIe TX Bandwidth
        metrics:
          - PCIe Write Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: PCIe to BAR Requests
        description: PCIe to BAR 0/1/2 read/write requests
        metrics:
          - PCIe Read Requests to BAR1
          - PCIe Write Requests to BAR1
          - PCIe Read Requests to BAR0
          - PCIe Write Requests to BAR0
          - PCIe Read Requests to BAR2
          - PCIe Write Requests to BAR2
        subMetrics:
          - Requests
        aggregationOp: max
      - name: ZCULL
        description: Total/Rejected number of samples sent to ZCULL
        metrics:
          - ZCULL Rejected Samples
          - ZCULL Input Samples
        subMetrics:
          - Throughput %
          - Sum
        aggregationOp: max
    timelineViews:
      - name: Default
        rows:
          - metricGroup: $root:Activity
            heightScale: 0.5
          - metricGroup: $root:Memory
            heightScale: -0.5
          - GPU Active
          - metricGroup: Unit Throughputs
            heightScale: 2
          - Compute in Flight
          - Draw/Dispatch Start
          - metricGroup: SM Occupancy (TPC View)
            heightScale: 2
          - Warp Can't Launch
          - SM Instruction Throughputs
          - L1 Throughputs
          - metricGroup: L2 Bandwidth
          - L2 Hit Rates
          - metricGroup: GPU Memory Bandwidth
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
          - PCIe to BAR Requests
          - ZCULL
  - name: Graphics Throughput Metrics for NVIDIA GA10x
    alias: ga10x-gfxt
    chips:
      - GA102
      - GA103
      - GA104
      - GA106
      - GA107
    setSpecifier: Default
    metrics:
      - name: GPU Active
        id: HOST.TriageSCG.gpu__engine_cycles_active_gr_or_ce
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#33B2B2"
      - name: Sync Copy Engine Active
        id: HOST.TriageSCG.gpu__engine_cycles_active_any_syncce
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Cycles Active
            suffix: .sum
        color: "#B2B233"
      - name: Async Copy Engine Active
        id: HOST.TriageSCG.gpu__engine_cycles_active_any_asyncce
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Cycles Active
            suffix: .sum
        color: "#FFA700"
      - name: GR Active
        id: FE_A.TriageSCG.gr__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of cycles the graphics/compute engine is active. The graphics and compute engine are active if there is any work in the graphics pipe or if the compute pipe is processing a dispatch.
        color: "#ED6A32"
      - name: SM Throughput
        id: TriageSCG.sm__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D100EE"
      - name: RTCORE Throughput
        id: rtcore__cycles_executed
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D18841"
      - name: VAF Throughput
        id: TPC.TriageSCG.vaf__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D13341"
      - name: L1 Throughput
        id: SM_A.TriageSCG.l1tex__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FFC425"
      - name: L2 Throughput
        id: LTS.TriageSCG.lts__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#00AEDB"
      - name: VRAM Throughput
        id: FBSP.TriageSCG.dramc__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#F37735"
      - name: PCIe Throughput
        id: PCI.TriageSCG.pcie__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#3577F3"
      - name: PD Throughput
        id: HUB_B.TriageSCG.pda__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#00B159"
      - name: PES+VPC Throughput
        id: GPC_B.TriageSCG.pes__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#3FB159"
      - name: RASTER Throughput
        id: GPC_A.TriageSCG.raster__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#6FB159"
      - name: PROP Throughput
        id: GPC_A.TriageSCG.prop__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#9FB159"
      - name: ZROP Throughput
        id: ROP.TriageSCG.zrop__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#854442"
      - name: CROP Throughput
        id: ROP.TriageSCG.crop__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#AFB159"
      - name: Sync Compute in Flight
        id: FE_A.TriageSCG.gr__compute_cycles_active_queue_sync
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FE7F9C"
      - name: Async Compute in Flight
        id: FE_A.TriageSCG.gr__compute_cycles_active_queue_async
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FFD179"
      - name: Draw Started
        id: FE_A.TriageSCG.fe__draw_count
        subMetrics:
          - name: Workloads
            suffix: .sum
        description: Number of draw calls started
        color: "#F0F000"
      - name: Dispatch Started
        id: FE_A.TriageSCG.gr__dispatch_count
        subMetrics:
          - name: Workloads
            suffix: .sum
        description: Number of compute dispatches/grid launches started
        color: "#00F0F0"
      - name: Vertex/Tess/Geometry Warps
        id: SM_B.TriageSCG.tpc__warps_active_shader_vtg_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        color: "#0057E7"
      - name: Pixel Warps
        id: TPC.TriageSCG.tpc__warps_active_shader_ps_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        color: "#008744"
      - name: Compute Warps
        id: TPC.TriageSCG.tpc__warps_active_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        color: "#FFA700"
      - name: Unallocated Warps in Active SMs
        id: TriageSCG.tpc__warps_inactive_sm_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        color: "#696969"
      - name: Idle SM Unused Warp Slots
        id: TriageSCG.tpc__warps_inactive_sm_idle_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        color: "#C0C0C0"
      - name: Active Threads Per Warp
        id: smsp__thread_inst_executed_pred_on_per_inst_executed
        subMetrics:
          - name: Threads/Warp
            suffix: .ratio
          - name: Coherence
            suffix: .pct
        color: green
      - name: FE Stalled Sync
        id: FE_A.TriageSCG.fe__cycles_stalled_cmd_wfi_queue_sync
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#AA1111"
      - name: FE Stalled Async
        id: FE_A.TriageSCG.fe__cycles_stalled_cmd_wfi_queue_async
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#11AA11"
      - name: Go Idle Sync
        id: FE_B.TriageSCG.fe__output_ops_cmd_go_idle_queue_sync
        subMetrics:
          - name: Commands
            suffix: .sum
        color: "#11AA11"
      - name: Subchannel Switch Sync
        id: FE_B.TriageSCG.fe__output_ops_cmd_subchsw_queue_sync
        subMetrics:
          - name: Commands
            suffix: .sum
        color: "#AA11AA"
      - name: Go Idle Async
        id: FE_B.TriageSCG.fe__output_ops_cmd_go_idle_queue_async
        subMetrics:
          - name: Commands
            suffix: .sum
        color: "#AA1111"
      - name: Subchannel Switch Async
        id: FE_B.TriageSCG.fe__output_ops_cmd_subchsw_queue_async
        subMetrics:
          - name: Commands
            suffix: .sum
        color: "#1111AA"
      - name: Pixel Shader Barriers
        id: FE_A.TriageSCG.fe__pixel_shader_barriers
        subMetrics:
          - name: Commands
            suffix: .sum
        color: "#11AAAA"
      - name: 3D Register Allocation
        id: TPC.TriageSCG.tpc__sm_rf_registers_allocated_shader_3d_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg Registers per SM
            suffix: .avg.per_cycle_elapsed
            multiplier: 0.5
        color: "#008744"
      - name: CS Register Allocation
        id: TPC.TriageSCG.tpc__sm_rf_registers_allocated_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg Registers per SM
            suffix: .avg.per_cycle_elapsed
            multiplier: 0.5
        color: "#FFA700"
      - name: CS Shared Memory Allocated (Sync)
        id: TPC.TriageSCG.tpc__l1tex_mem_shared_data_compute_bytes_allocated_queue_sync_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg Bytes
            suffix: .avg.per_cycle_elapsed
        color: "#B2B233"
      - name: CS Shared Memory Allocated (Async)
        id: TPC.TriageSCG.tpc__l1tex_mem_shared_data_compute_bytes_allocated_queue_async_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg Bytes
            suffix: .avg.per_cycle_elapsed
        color: "#B233B2"
      - name: VTG ISBE Memory Allocated
        id: TPC.TriageSCG.tpc__l1tex_mem_shared_data_isbe_bytes_allocated_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg Bytes
            suffix: .avg.per_cycle_elapsed
        color: "#33B2B2"
      - name: PS TRAM Memory Allocated
        id: TPC.TriageSCG.tpc__l1tex_mem_shared_data_tram_bytes_allocated_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg Bytes
            suffix: .avg.per_cycle_elapsed
        color: "#33B233"
      - name: Active Thread Groups in SM
        id: SM_B.TriageSCG.sm__ctas_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg CTAs per SM
            suffix: .avg.per_cycle_elapsed
        color: "#B23333"
      - name: SM Issue Active
        id: SM_A.TriageSCG.sm__inst_executed_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Instructions
            suffix: .sum
          - name: Avg Inst/Clk per SM
            suffix: .avg.per_cycle_elapsed
          - name: Peak Inst/Clk per SM
            suffix: .avg.peak_sustained
        description: SM instruction issue rate. Each SM can issue 4 instructions/cycle (1 instruction/SMSP/cycle).
        color: "#CFCF3F"
      - name: SM ALU Pipe Throughput
        id: SM_A.TriageSCG.sm__inst_executed_pipe_alu_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Instructions
            suffix: .sum
          - name: Avg Inst/Clk per SM
            suffix: .avg.per_cycle_elapsed
          - name: Peak Inst/Clk per SM
            suffix: .avg.peak_sustained
        color: "#FF6F00"
      - name: SM FMA Light Pipe Throughput
        id: SM_C.TriageSCG.smsp__inst_executed_pipe_fmalite
        subMetrics:
          - name: Throughput %
