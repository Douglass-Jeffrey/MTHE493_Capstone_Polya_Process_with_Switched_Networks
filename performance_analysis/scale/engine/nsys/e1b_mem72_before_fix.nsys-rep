    metricGroups:
      - name: $root:Activity
        metrics:
          - GR Engine Active
          - Sync Compute in Flight
          - Async Compute in Flight
          - Sync Copy Engine Active
          - Async Copy Engine 0 Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: $root:Memory
        metrics:
          - PCIe Throughput
          - VRAM Total Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: GPU Engine Activity
        description: "The GPU engines shown here can all execute in parallel.\nThe GR engine is the combined 3D and Compute engine.\n"
        metrics:
          - GR Engine Active
          - Sync Compute in Flight
          - Async Compute in Flight
          - Sync Copy Engine Active
          - Async Copy Engine 0 Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Top-Level Throughput
        description: "Identify which portion of the system is closest to reaching its %-of-peak.\nLow throughput usually indicates a latency-limited workload, or starvation.  First rule out starvation by checking workload launch sizes and warp occupancy.\nHigh throughput is usually good, but there may be speedup opportunities by offloading the highest unit, or reducing its workload.\n"
        metrics:
          - PCIe Throughput
          - VRAM Total Bandwidth
          - SysL2 Throughput
          - VidL2 Throughput
          - SM Throughput
          - L1TEX Throughput
          - RTCORE Throughput
          - Screen Pipe Throughput
          - World Pipe Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe Bandwidth
        description: "Total PCIe bandwidth.\nPCIe is a full-duplex interface.  The RX and TX hard-wires can transfer in parallel.\n"
        metrics:
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: VRAM Bandwidth
        description: "Total VRAM bandwidth to onboard DRAM.\nDRAM is a half-duplex interface.  Read and write occur in alternation.\n"
        metrics:
          - VRAM Read Bandwidth
          - VRAM Write Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: SysL2 Throughput
        description: "Observe the SysL2 cache's %-of-peak, and find its top limiters.\nThe SysL2 cache serves SysMem and PeerMem aperture accesses.\n"
        metrics:
          - SysL2 Request Active
          - SysL2-to-XBAR Active
          - XBAR-to-SysL2 Active
          - SysL2 Request Stage Active
          - SysL2 Atomic Stage Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: VidL2 Throughput
        description: "Observe the VidL2 cache's %-of-peak, and find its top limiters.\nThe VidL2 cache serves VidMem aperture accesses, and is connected to the onboard VRAM.\n"
        metrics:
          - VidL2 Sectors
          - VidL2-to-XBAR Active
          - XBAR-to-VidL2 Active
          - VidL2 Request Active
          - VidL2 Atomic Stage Active
          - VidL2 CBC Requests
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Throughput
        description: "Observe the shader cores' %-of-peak for instruction issue and math performance.\nALU = INT32, except for integer multiply and dot-product.\nALU 64bit = INT64 operations.\nFMA is representative of FP16 and FP32 performance.\nFMAHeavy is representative of integer multiply and dot-product performance.\nXU = the special function unit, for reciprocals, square-roots, and transcendentals.\nTensor performs GLSL Cooperative Matrix, HLSL Wave Matrix operations, and CUDA MMA.\nUniform performs warp-level scalar operations.\n"
        metrics:
          - SM Issue Stage Throughput
          - SM ALU Pipe Throughput
          - SM ALU 64-bit Pipe Throughput
          - SM FMA Pipe Throughput
          - SM FMAHeavy Pipe Throughput
          - SM FMAHeavy Pipe Active
          - SM XU Pipe Throughput
          - SM Tensor Pipe Active
          - SM Uniform Pipe Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1TEX Throughput
        description: "Observe the combined L1Data and Texture cache's %-of-peak, and find its top limiters.\nIf achieved bandwidth is low, but throughput is high, it may imply an inefficient access pattern (lacking coalescing, shared memory bank conflicts, etc.).\n\nThe combined L1Data and Texture cache has two parallel pipelines:\nLSU : local, global, surface store/atom, shared memory, 3D attributes, shuffle/redux/match/S2R\nTEX : texture and surface reads and atomic-returns; performs bilinear/trilinear/aniso filtering\nCache Fills and the RTCORE unit contend with LSU and TEX.\n\nThe 128KB of on-chip RAM per SM is composed of 2 x 64KB SRAMs. Shared memory grows upwards (starting in SRAM 0), while tagged memory grows downwards (from the end of SRAM 1).\n"
        metrics:
          - L1TEX Data SRAM 0 Reads
          - L1TEX Data SRAM 0 Writes
          - L1TEX Data SRAM 1 Reads
          - L1TEX Data SRAM 1 Writes
          - L1TEX LSU Data-Stage Throughput
          - L1TEX LSU Writeback-Stage Throughput
          - L1TEX Texture Data-Stage Throughput
          - L1TEX Texture Filter-Stage Throughput
          - L1TEX Texture Writeback-Stage Throughput
          - L1TEX-to-XBAR Cycles Active
          - XBAR-to-L1TEX Sectors
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: RTCORE Throughput
        description: "The RTCORE's %-of-peak utilization.\n"
        metrics:
          - RTCORE Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Screen Pipe Throughput
        description: "Observe the Screen Pipe's %-of-peak, and find its top limiters.\n* CROP = Color Raster Operation, which performs the output merger color blend.\n* ZROP = Depth Raster Operation, which performs fine depth tests.\n* STRI = Setup Triangle, which generates pixel shader attributes and stores them into TRAM.\n* PROP = Pre-ROP, which orchestrates depth-testing, pixel shading, and color blending.\n* ZCULL= coarse depth test.\n"
        metrics:
          - CROP Input Pixels
          - ROP Throughput
          - SM Pixels Shaded in EarlyZ Mode
          - ZROP Input Pixels
          - SM Pixels Shaded in LateZ Mode
          - STRI Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: World Pipe Throughput
        description: "Observe the World Pipe's %-of-peak, and find its top limiters.\n* PDA = Primitive Distributor, which performs input assembly tasks.\n* VAF = Vertex Attribute Fetch, for vertex shaders.\n"
        metrics:
          - PDA Index Fetch
          - PDA Primitives In
          - VAF Throughput
          - VAF Alpha-Phase Attribute Fetch
          - VAF Beta-Phase Attribute Fetch
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: System Memory
        description: "Bandwidth to the system memory aperture, at the SysL2 Request stage, SysL2 Miss stage, and at the PCIe connection.\n"
        metrics:
          - SysL2 Total Memory Bandwidth
          - SysL2 Miss Bandwidth
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: SysL2 Bandwidth per Destination
        description: "Bandwidth requests to the GPU's SysL2 cache per memory aperture.\nIf a large amount of traffic is going to system memory, consider allocating VRAM buffers, and separately copying results in/out.\n"
        metrics:
          - SysL2-to-SysMem Bandwidth
          - SysL2-to-PeerMem Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: SysL2 Bandwidth per Source Unit
        description: "Bandwidth requests to the GPU's L2 cache, broken down by source unit.\nThis row makes it easy to determine which units are missing in their L1 caches, or otherwise generating a large amount of memory traffic.\n"
        metrics:
          - SysL2 Bandwidth from L1TEX
          - SysL2 Bandwidth from GCC
          - SysL2 Bandwidth from PE
          - SysL2 Bandwidth from CROP
          - SysL2 Bandwidth from ZROP
          - SysL2 Bandwidth from Raster
          - SysL2 Bandwidth from CE
          - SysL2 Bandwidth from Other HUB Units
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: SysL2 Sector Hit-Rate (Total)
        description: "Use this row to diagnose latency-limited workloads.\n"
        metrics:
          - SysL2 Sector Hit-Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: SysL2 Sector Hit-Rate per Source Unit
        description: "Use this row to diagnose latency-limited workloads.\n"
        metrics:
          - SysL2 Sector Hit-Rate from L1TEX
          - SysL2 Sector Hit-Rate from GCC
          - SysL2 Sector Hit-Rate from PE
          - SysL2 Sector Hit-Rate from CROP
          - SysL2 Sector Hit-Rate from ZROP
          - SysL2 Sector Hit-Rate from Raster
          - SysL2 Sector Hit-Rate from CE
          - SysL2 Sector Hit-Rate from GPC
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: Video Memory
        description: "Bandwidth to the video memory aperture, at the VidL2 Request, VidL2 Miss, and VRAM (onboard DRAM) stages.\n"
        metrics:
          - VRAM Total Bandwidth
          - VidL2 Miss Bandwidth
          - VidL2 Sectors
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: VidL2 Bandwidth per Source Unit
        description: "Bandwidth requests to the GPU's VidL2 cache, broken down by source unit.\nThis row makes it easy to determine which units are missing in their L1 caches, or otherwise generating a large amount of memory traffic.\n"
        metrics:
          - VidL2 Total from L1TEX
          - VidL2 Bandwidth from GCC
          - VidL2 Bandwidth from PE
          - VidL2 Bandwidth from CROP
          - VidL2 Bandwidth from ZROP
          - VidL2 Bandwidth from Raster
          - VidL2 Bandwidth from CE
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: VidL2 Sector Hit-Rate (Total)
        description: "Use this row to diagnose latency-limited workloads.\n"
        metrics:
          - VidL2 Sector Hit-Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: VidL2 Sector Hit-Rate per Source Unit
        description: "Use this row to diagnose latency-limited workloads.\n"
        metrics:
          - VidL2 Sector Hit-Rate from L1TEX
          - VidL2 Sector Hit-Rate from GCC
          - VidL2 Sector Hit-Rate from PE
          - VidL2 Sector Hit-Rate from CROP
          - VidL2 Sector Hit-Rate from ZROP
          - VidL2 Sector Hit-Rate from Raster
          - VidL2 Sector Hit-Rate from CE
          - VidL2 Sector Hit-Rate from GPC
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: Active Threads Per Warp
        description: "The average active and predicated-on threads per instruction executed.\n"
        metrics:
          - Predicated-On Active Threads Per Warp
        subMetrics:
          - Threads/Warp
          - Coherence
        aggregationOp: max
      - name: SM Warp Occupancy
        description: "The number of occupied warp slots, on average.\nDo not worry about warp occupancy unless SM Instruction Throughput is low.  Increasing warp occupancy is one way to improve the issue rate, but there are other ways as well (increasing intra-warp arithmetic intensity, reducing long latency operations).\nFewer than 4 warps on an SM is a starvation condition; launch bigger workloads.\nHigher is not always better.  16 warps/SM is enough to fully hide math pipe latency.\nUnused slots on Active SMs usually imply that an occupancy limiter was reached.\n"
        metrics:
          - Vertex/Tess/Geometry Warps
          - Pixel Warps
          - Sync CS SM Warps
          - Async CS SM Warps
          - Unallocated Warps in Active SMs
        subMetrics:
          - Avg Warps
          - Occupancy %
        aggregationOp: sum
      - name: SM Register Occupancy
        description: "Each SM subpartition has a register file with 16K x 4Byte registers.\nEach warp allocates registers in chunks of 8 registers/thread x 32 threads/warp = 256 registers.\n"
        metrics:
          - CS Register Allocation (Sync)
          - CS Register Allocation (Async)
          - VTG Register Allocation
          - Pixel Register Allocation
        subMetrics:
          - Occupancy %
          - Avg Registers per SM
        aggregationOp: max
      - name: SM Compute Thread Group Occupancy
        description: "At most, 24 compute work groups can be resident on a single SM at any given time.\nA compute work group is otherwise known as a thread group, thread block, or CTA.\n"
        metrics:
          - Active Thread Groups in SM (sync)
          - Active Thread Groups in SM (async)
        subMetrics:
          - Throughput %
          - Avg CTAs per SM
        aggregationOp: max
      - name: L1TEX Data Occupancy
        description: "This row shows the partitioning of the 128KB on-chip memory per SM into Compute shared memory, VTG shader attributes (ISBE), Pixel shader attributes (TRAM), and tagged cache memory.\n* When compute or VTG shaders are running, a partition is dynamically created for shared memory + ISBEs. When this partition is full, compute and VTG warp launches will stall.\n* When pixel shaders are running, a 16KB partition is created.  When this partition is full, pixel warp launches will stall.  Each component of a pixel shader attribute consumes 12B per triangle; `in vec4 myAttrib;` would consume 48B per triangle.\n* The remainder - tagged cache - serves local, global, texture, and surface memory accesses.\n"
        metrics:
          - Shared Mem CLQ0 Allocated
          - Shared Mem CLQ1 Allocated
          - ISBE Allocated
          - Shared Mem Unallocated
          - TRAM Allocated
          - TRAM Unallocated
          - Tagged Mem
        subMetrics:
          - Bytes/SM
        aggregationOp: sum
      - name: Warps Launched
        description: "Indicates when shader warps were launched onto SMs.\n"
        metrics:
          - VTG Warps Launched
          - Pixel Warps Launched
          - Sync Compute Warps Launched
          - Async Compute Warps Launched
        subMetrics:
          - Warps/us
          - Warps
        aggregationOp: sum
      - name: Threads Launched
        description: "Indicates when shader threads were launched onto SMs, and the degree of unused (masked off) thread at warp launch time.\n"
        metrics:
          - Threads Launched, CS+VTG
          - Threads Launched, Pixels with Coverage
          - Threads Launched, Pixel Helper Threads
          - Threads Launched Masked Off
        subMetrics:
          - Threads/us
          - Threads
        aggregationOp: sum
      - name: Threads Launched Per Warp
        description: "Indicates the number of threads initially active per launched warp.  Higher is better.\nIf you see low values, inspect the shaders running in this region:\n* Do any compute shaders have thread group dimensions that aren't evenly divisible by 32?\n* For pixel shaders, are there too many small triangles?  See also: Avg. Pixels per Rasterized Primitive.\n"
        metrics:
          - Threads Launched Per Warp
          - Threads Launched Per Pixel Warp
        subMetrics:
          - Threads/Warp
          - Coherence
        aggregationOp: max
      - name: SM Memory Bandwidth
        description: "The overall bandwidth from the SM to each memory path.\nThis memory traffic is generated (directly or indirectly) by shaders or CUDA kernels.\nThe metrics in this row are overlaid to show the absolute magnitude; however, this disregards pipeline or bus sharing.  See additional L1TEX Throughput and Bandwidth rows to understand those types of limiters.\n"
        metrics:
          - L1TEX Shared Memory Bandwidth
          - L1TEX Tag-Stage Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: max
      - name: L1TEX LSU Throughput
        description: "Observe the Load/Store Unit's %-of-peak, and find its top limiters.\nIf LSU Data > LSU Writeback, it's likely poor address coalescing (local / global / surface), or high bank conflicts (shared).\nIf LSU Writeback > LSU Data, it's likely due to 64-bit or 128-bit uniform loads.\n"
        metrics:
          - L1TEX LSU Data-Stage Throughput
          - L1TEX LSU Writeback-Stage Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1TEX LSU Throughput per Memory Space
        description: "Determine the main contributor to high LSU throughput.\nLocal memory is used by indexed per-thread arrays, and compiler spills when out-of-registers.\nGlobal memory corresponds to certain types of buffers, like byte addressed buffers.\nShared memory is groupshared in HLSL, or 'shared\" in GLSL.\nAttributes are for any 3D shaders - VTG or Pixel.\nWave Intrinsics include shuffles and warp-level reductions.\nSurface stores include things like RWTexture2D writes.  Includes surface atomics as well.\n"
        metrics:
          - L1TEX Local+Global Data-Stage Throughput
          - L1TEX LSU Data Wavefronts for Shared+Attribute Memory
          - L1TEX LSU Data Wavefronts for Wave Intrinsics + Misc
          - L1TEX Surface Data-Stage Throughput
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: Local/Global/Texture/Surface Bandwidth
        description: "Bandwidth requests to \"tagged\" memory spaces that reside in main memory.\nIncludes local, global, texture, and surface memory accesses.\nDoes not include shared memory or 3D attributes.\n"
        metrics:
          - L1TEX Tag-Stage Bandwidth
          - L1TEX Tag-Stage Bandwidth (miss)
          - VidL2 Total from L1TEX
          - VidL2 Misses from L1TEX
          - SysL2 Bandwidth from L1TEX
          - SysL2 Misses from L1TEX
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: L1TEX Tag-Stage Bandwidth per Hit/Miss
        description: "Bandwidth requests to \"tagged\" data memory spaces that reside in main memory, decomposed into hit and miss bandwidth.\nTagged data memory includes local, global, texture, and surface memory accesses.\n"
        metrics:
          - L1TEX Tag-Stage Bandwidth (hit)
          - L1TEX Tag-Stage Bandwidth (miss)
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: L2 Sector Hit-Rates from L1TEX
        description: "If the hit-rates in this row are low, it means data accesses are missing in both the L1TEX cache and the L2 cache.  These accesses will pay the full latency penalty of a main memory access (to system memory or video memory).\n"
        metrics:
          - VidL2 Sector Hit-Rate from L1TEX Reads
          - VidL2 Sector Hit-Rate from L1TEX Writes
          - VidL2 Sector Hit-Rate from L1TEX Atomics
          - SysL2 Sector Hit-Rate from L1TEX Reads
          - SysL2 Sector Hit-Rate from L1TEX Writes
          - SysL2 Sector Hit-Rate from L1TEX Atomics
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: L1TEX Cache Capacity per Warp
        description: "The average L1Data cache available per resident warp.\nIf the L1TEX Tag-Stage Sector Hit-Rate is low, this per-warp capacity is being exceeded.\n"
        metrics:
          - L1Data Space per Warp
        subMetrics:
          - kB
        aggregationOp: max
      - name: GCC Bandwidth
        description: "The GCC is a mid-level cache for constant, instruction, and texture/surface descriptor memory.  It sits between the corresponding L1 caches (DCC, IDC, ICC, TSL1) and the L2 caches.\nThis row shows the overall bandwidth for these memory spaces, and the flow through the cache hierarchy.\n"
        metrics:
          - VidL2 Bandwidth from GCC
          - VidL2 Sector Misses from GCC
          - SysL2 Bandwidth from GCC
          - SysL2 Sector Misses from GCC
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: GCC Bandwidth per Type
        description: "The GCC Constant Cache's bandwidth is proportional to miss-traffic from various L1 caches in the SMs.\n[128-bytes / cycle] Instruction requests come from the SM L1I$, aka ICC.\n[  64-bytes / cycle] Constant requests come from the DCC (scalar constant cache) or IDC (indexed constant cache).\n"
        metrics:
          - GCC Inst Bandwidth
          - GCC Constant Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: GCC Hit-Rates
        description: "Observe the hit-rate of each memory space served by the GCC cache:\nIf low instruction hit-rate: consider reducing loop unrolling, force-no-inline, or trying shader subroutines / callable shaders [in ray tracing].\nIf low constant hit-rate: consider compacting data into 64B or 256B aligned regions (cache & prefetch-friendly), and reducing indexed constant loads.\n"
        metrics:
          - GCC Constant Hit-Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: GCC Tag-Stage Miss-Bandwidth per Type
        description: "The approximate miss bandwidth from GCC to L2.\nThis row shows tag misses, not true misses.\n"
        metrics:
          - GCC Inst Miss Bandwidth
          - GCC Constant Miss Bandwidth
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: Compute Engine
        description: "This row indicates whether a compute dispatch is in the pipeline, per queue family.\nA dispatch that was started, but hasn't yet launched a thread group, will be counted here.\nDispatches may be queued for a long time, before launching their first thread group.\n"
        metrics:
          - Sync Compute in Flight
          - Async Compute in Flight
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: CWD Thread Groups Launched
        description: "This row indicates when CTAs were launched from CWD to the SMs.\n"
        metrics:
          - Sync CTAs launched
          - Async CTAs launched
        subMetrics:
          - CTAs/us
          - CTAs
        aggregationOp: sum
      - name: 3D Engine
        description: "This row indicates when the 3D engine was active.\n"
        metrics:
          - Screen Pipe Throughput
          - World Pipe Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: CROP Blended Pixels
        description: "This row shows the number of color pixels sent to CROP for color blending.\nWhen multiple render targets (MRT) are in use, the ratio of CROP Pixels / Z-Passed Pixels ~= #MRT. In other words, the number of pixels reported increses for each zpassed-pixel, for each render target.\n"
        metrics:
          - CROP Input Pixels
        subMetrics:
          - Pixels-per-Cycle
          - Throughput %
          - Pixels
        aggregationOp: max
      - name: Depth Pixel Data Flow
        description: "Observe the creation and reduction of work through Raster, Shading, and ROP.\nThe rasterizer has a max rate of 64 pixels/cycle/GPC, divided by the MSAA level.\nThe color ROP pipeline has a max rate of 16 pixels/cycle/GPC.\n"
        metrics:
          - SM Pixels Shaded in EarlyZ Mode
          - ZROP Input Pixels
          - SM Pixels Shaded in LateZ Mode
        subMetrics:
          - Pixels-per-Cycle
          - Throughput %
          - Pixels
        aggregationOp: max
      - name: Primitive Data Flow
        description: "Observe the World Pipe's %-of-peak, and find its top limiters.\n* PD = Primitive Distributor, which performs input assembly work.\n"
        metrics:
          - PDA Primitives In
          - Vertex Shaded Primitives
        subMetrics:
          - Throughput %
          - Prim/GPC
          - Primitives
        aggregationOp: max
      - name: L2 Bandwidth from 3D Units
        description: "L2 Bandwidth from all 3D fixed-function units.\n"
        metrics:
          - VidL2 Bandwidth from PE
          - VidL2 Bandwidth from Raster
          - VidL2 Bandwidth from ZROP
          - VidL2 Bandwidth from CROP
          - SysL2 Bandwidth from PE
          - SysL2 Bandwidth from Raster
          - SysL2 Bandwidth from ZROP
          - SysL2 Bandwidth from CROP
        subMetrics:
          - Throughput %
          - Bytes
          - GB/s
        aggregationOp: sum
      - name: L2 Sector Hit-Rates from 3D Units
        description: "Low L2 Hit-Rates from fixed-function 3D units may imply the following:\n* In general, memory pages marked as \"GPU uncacheable\"\n* In general, use of pitch-linear (row-major) layouts for 2D or 3D surfaces.\n*\n"
        metrics:
          - VidL2 Sector Hit-Rate from PE
          - VidL2 Sector Hit-Rate from PE Reads
          - VidL2 Sector Hit-Rate from Raster
          - VidL2 Sector Hit-Rate from CROP
          - VidL2 Sector Hit-Rate from ZROP
          - SysL2 Sector Hit-Rate from PE
          - SysL2 Sector Hit-Rate from PE Reads
          - SysL2 Sector Hit-Rate from Raster
          - SysL2 Sector Hit-Rate from CROP
          - SysL2 Sector Hit-Rate from ZROP
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: 3D Queue Engine Activity
        description: "3D Queues have the following engines\n* 3D Engine : for draw calls. Shown here via Warp Occupancy counters.\n* 2D Engine : for texture copies, including scaled blits. (not shown)\n* Sync Copy Engine : for buffer copies\n* Sync Compute Engine : for compute dispatches\n"
        metrics:
          - Sync Copy Engine Active
          - Sync Compute in Flight
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: Compute Q Engine Activity
        description: "Observe the active engines within the GPU, and their degree of overlap.\nThe GR engine is the combined 3D and Compute engine.\n"
        metrics:
          - Async Compute in Flight
        subMetrics:
          - Cycles
        aggregationOp: max
      - name: Clock Frequencies
        description: "The GPU is divided into many clock domains; this row shows their frequencies over time.\n"
        metrics:
          - GPC Frequency
          - SYS Frequency
          - VidL2 Frequency
        subMetrics:
          - MHz
          - Cycles
        aggregationOp: max
      - name: PCIe Incoming BAR Accesses
        description: "BAR1: CPU-Visible-VRAM accesses from the CPU, or peer GPU accesses.  BAR1 reads are bad for CPU performance; these buffers are intended for CPU written data only.\n"
        metrics:
          - PCIe Read Requests to BAR1
          - PCIe Write Requests to BAR1
        subMetrics:
          - Requests/us
          - Requests
        aggregationOp: max
    timelineViews:
      - name: Default
        rows:
          - metricGroup: $root:Activity
            heightScale: 0.5
          - metricGroup: $root:Memory
            heightScale: -0.5
          - GPU Engine Activity
          - metricGroup: Top-Level Throughput
            heightScale: 4
            children:
              - PCIe Bandwidth
              - metricGroup: VRAM Bandwidth
              - SysL2 Throughput
              - VidL2 Throughput
              - SM Throughput
              - L1TEX Throughput
              - RTCORE Throughput
              - Screen Pipe Throughput
              - World Pipe Throughput
          - metricGroup: System Memory
            children:
              - PCIe Bandwidth
              - metricGroup: SysL2 Bandwidth per Destination
              - metricGroup: SysL2 Bandwidth per Source Unit
              - SysL2 Sector Hit-Rate (Total)
              - SysL2 Sector Hit-Rate per Source Unit
              - SysL2 Throughput
          - metricGroup: Video Memory
            children:
              - metricGroup: VRAM Bandwidth
              - metricGroup: VidL2 Bandwidth per Source Unit
              - VidL2 Sector Hit-Rate (Total)
              - VidL2 Sector Hit-Rate per Source Unit
              - VidL2 Throughput
          - metricGroup: SM Throughput
            children:
              - Active Threads Per Warp
          - metricGroup: SM Warp Occupancy
            heightScale: 3
            children:
              - SM Register Occupancy
              - SM Compute Thread Group Occupancy
              - metricGroup: L1TEX Data Occupancy
              - metricGroup: Warps Launched
              - metricGroup: Threads Launched
              - Threads Launched Per Warp
          - RTCORE Throughput
          - metricGroup: SM Memory Bandwidth
            children:
              - metricGroup: L1TEX Throughput
                children:
                  - L1TEX LSU Throughput
                  - metricGroup: L1TEX LSU Throughput per Memory Space
              - metricGroup: Local/Global/Texture/Surface Bandwidth
                children:
                  - metricGroup: L1TEX Tag-Stage Bandwidth per Hit/Miss
                  - L2 Sector Hit-Rates from L1TEX
                  - L1TEX Cache Capacity per Warp
              - metricGroup: GCC Bandwidth
                children:
                  - metricGroup: GCC Bandwidth per Type
                  - GCC Hit-Rates
                  - metricGroup: GCC Tag-Stage Miss-Bandwidth per Type
          - metricGroup: Compute Engine
            type: stacked
            children:
              - metricGroup: CWD Thread Groups Launched
          - metricGroup: 3D Engine
            children:
              - CROP Blended Pixels
              - Depth Pixel Data Flow
              - Primitive Data Flow
              - Screen Pipe Throughput
              - World Pipe Throughput
              - metricGroup: L2 Bandwidth from 3D Units
              - L2 Sector Hit-Rates from 3D Units
          - metricGroup: 3D Queue Engine Activity
          - Compute Q Engine Activity
          - metricGroup: Clock Frequencies
            drawStyle: line
          - PCIe Incoming BAR Accesses
  - name: General Metrics for NVIDIA GR10x
    alias: gr10x
    chips:
      - GR100
    setSpecifier: Default
    customMetricDefinitions:
      - nsys.nvltx__bytes_data_protocol:
          counter:
            expr: nvltx__bytes - nvltx__bytes_data_user
            sustainedRate: 1.0
          description: "# of bytes of NVLTX overhead data, at 32B granularity"
      - nsys.nvlrx__bytes_data_protocol:
          counter:
            expr: nvlrx__bytes - nvlrx__bytes_data_user
            sustainedRate: 1.0
          description: "# of bytes of NVLRX overhead data, at 32B granularity"
    metrics:
      - name: GPC Clock Frequency
        id: gpc__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the GPC graphics clock. In NVIDIA GPU Specs this is the Boost Clock and Base Clock. In nvidia-smi this is the "gr", "graphics", "Graphics Clock".
        color: "#8BDDB4"
      - name: SYS Clock Frequency
        id: sys__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the SYS clock. The SYS clock is the clock used for the copy engines, compute and graphics command processor, and the hardware performance monitor streaming unit.
        color: "#118E44"
      - name: Sync Copy Engine Active
        id: gpu__engine_cycles_active_any_syncce
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Cycles Active
            suffix: .sum
        color: "#B2B233"
      - name: GR Active
        id: gr__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of cycles the graphics/compute engine is active. The graphics and compute engine are active if there is any work in the graphics pipe or if the compute pipe is processing a dispatch.
        color: "#ED6A32"
      - name: SMs Active
        id: sm__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles SMs had at least 1 warp in flight to the number of cycles
        color: "#FFA5A5"
      - name: SM Issue
        id: sm__inst_executed_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: SM instruction issue rate. Each SM can issue 4 instructions/cycle (1 instruction/SMSP/cycle).
        color: "#98C4DD"
      - name: Tensor Active
        id: sm__pipe_tensor_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles the tensor pipe is active
        color: "#76B900"
      - name: Compute Warps in Flight
        id: tpc__warps_active_shader_cs_realtime
        subMetrics:
          - name: Occupancy %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Warps/SM
            suffix: .avg.per_cycle_elapsed
            maxValueSuffix: .avg.peak_sustained
            multiplier: 0.5
        description: Total number of compute shader warps in flight
        color: "#FFD179"
      - name: DRAM Read Bandwidth
        id: dram__read_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active reading data to the elapsed cycles in the same period as a percentage
        color: "#FFA5A5"
      - name: DRAM Write Bandwidth
        id: dram__write_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active writing data to the elapsed cycles in the same period as a percentage
        color: "#98C4DD"
      - name: NVLink RX Protocol Data
        id: nsys.nvlrx__bytes_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX protocol data
        color: "#C79536"
      - name: NVLink RX User Data
        id: nvlrx__bytes_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX user data
        color: "#FFD179"
      - name: NVLink TX Protocol Data
        id: nsys.nvltx__bytes_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX protocol data
        color: "#9052BF"
      - name: NVLink TX User Data
        id: nvltx__bytes_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX user data
        color: "#D6A4FC"
      - name: PCIe RX Throughput
        id: pcie__read_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes received by GPU (includes protocol)
        color: "#FF3D00"
      - name: PCIe TX Throughput
        id: pcie__write_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes transmitted by GPU (includes protocol)
        color: "#00CFCF"
    metricGroups:
      - name: $root:Activity
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: $root:Memory
        metrics:
          - NVLink RX User Data
          - NVLink TX User Data
          - PCIe RX Throughput
          - PCIe TX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GPC Clock Frequency
        metrics:
          - GPC Clock Frequency
        subMetrics:
          - MHz
        aggregationOp: max
      - name: SYS Clock Frequency
        metrics:
          - SYS Clock Frequency
        subMetrics:
          - MHz
        aggregationOp: max
      - name: GPU Active
        description: The graphics or copy engine is active
        metrics:
          - Sync Copy Engine Active
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SMs Active
        metrics:
          - SMs Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Instructions
        metrics:
          - SM Issue
          - Tensor Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Warp Occupancy
        metrics:
          - Compute Warps in Flight
        subMetrics:
          - Occupancy %
          - Warps/SM
        aggregationOp: sum
      - name: DRAM Bandwidth
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: NVLink RX Bandwidth
        metrics:
          - NVLink RX Protocol Data
          - NVLink RX User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: NVLink TX Bandwidth
        metrics:
          - NVLink TX Protocol Data
          - NVLink TX User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: PCIe RX Bandwidth
        metrics:
          - PCIe RX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe TX Bandwidth
        metrics:
          - PCIe TX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
    timelineViews:
      - name: Default
        rows:
          - metricGroup: $root:Activity
            heightScale: 0.5
          - metricGroup: $root:Memory
            heightScale: -0.5
          - GPC Clock Frequency
          - SYS Clock Frequency
          - GPU Active
          - SMs Active
          - SM Instructions
          - metricGroup: SM Warp Occupancy
            heightScale: 3
          - metricGroup: DRAM Bandwidth
          - metricGroup: NVLink RX Bandwidth
          - metricGroup: NVLink TX Bandwidth
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
  - name: Compute Triage Metrics for NVIDIA GR10x
    alias: gr10x-ct
    chips:
      - GR100
    setSpecifier: Default
    customMetricDefinitions:
      - TriageCompute.dram__throughput:
          throughput:
            - dram__sectors
          description: DRAM Throughput (TriageCompute Configuration)
      - TriageCompute.dram__write_throughput:
          throughput:
            - dram__sectors_op_write
          description: DRAM Write Throughput (TriageCompute Configuration)
      - TriageCompute.gcc__cache_bytes:
          counter:
            expr: 128 * gcc__cache_requests_type_instruction + 64 * gcc__cache_requests_type_constant
            sustainedRate: 128.0
          description: "# of bytes GCC cached"
      - TriageCompute.gcc__cache_bytes_lookup_miss:
          counter:
            expr: 128 * gcc__cache_requests_type_instruction_lookup_miss + 64 * gcc__cache_requests_type_constant_lookup_miss
            sustainedRate: 128.0
          description: "# of bytes GCC cached that missed"
      - TriageCompute.gr_total_ctas_launched_realtime:
          counter:
            expr: gr__ctas_launched_realtime + gr__workids_granted_as_ctas_realtime
            sustainedRate: 1.0
      - TriageCompute.l1tex__data_pipe_lsu_wavefronts:
          counter:
            expr: l1tex__data_pipe_lsu_wavefronts_mem_lgds + l1tex__data_pipe_lsu_wavefronts_mem_shared
            sustainedRate: 1.0
      - TriageCompute.l1tex__throughput:
          throughput:
            - TriageCompute.l1tex__data_pipe_lsu_wavefronts
            - l1tex__data_pipe_tc_wavefronts
            - l1tex__lsu_writeback_active
            - l1tex__m_l1tex2xbar_req_cycles_active_realtime
            - l1tex__m_xbar2l1tex_read_sectors_realtime
          description: l1tex throughput for (TriageCompute Configuration)
      - TriageCompute.lts__t_sectors_srcunit_ce_lookup_hit_realtime:
          counter:
            expr: lts__t_sectors_srcunit_ce_realtime - lts__t_sectors_srcunit_ce_lookup_miss_realtime
            sustainedRate: 1.0
          description: "# of LTS sectors from unit CE that hit"
      - TriageCompute.lts__average_t_sector_hit_rate_srcunit_ce_realtime:
          ratio:
            expr: TriageCompute.lts__t_sectors_srcunit_ce_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_ce_realtime, RollupOp.sum
            maxRate: 1.0
          description: proportion of L2 sector lookups from unit CE that hit
      - TriageCompute.lts__t_sectors_srcunit_gcc_lookup_hit_realtime:
          counter:
            expr: lts__t_sectors_srcunit_gcc_realtime - lts__t_sectors_srcunit_gcc_lookup_miss_realtime
            sustainedRate: 1.0
          description: "# of LTS sectors from unit GCC that hit"
      - TriageCompute.lts__average_t_sector_hit_rate_srcunit_gcc_realtime:
          ratio:
            expr: TriageCompute.lts__t_sectors_srcunit_gcc_lookup_hit_realtime, RollupOp.sum, lts__t_sectors_srcunit_gcc_realtime, RollupOp.sum
            maxRate: 1.0
          description: proportion of L2 sector lookups from unit GCC that hit
      - TriageCompute.lts__t_sectors_srcunit_tex_op_atom_realtime:
          counter:
            expr: lts__t_sectors_srcunit_tex_realtime - lts__t_sectors_srcunit_tex_op_read_realtime - lts__t_sectors_srcunit_tex_op_write_realtime
            sustainedRate: 1.0
      - TriageCompute.lts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime:
          counter:
            expr: TriageCompute.lts__t_sectors_srcunit_tex_op_atom_realtime - (lts__t_sectors_srcunit_tex_lookup_miss_realtime - lts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime - lts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime)
            sustainedRate: 1.0
          description: "# of LTS sectors from unit L1TEX for all atomics or reductions that hit"
      - TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_atom_realtime:
          ratio:
            expr: TriageCompute.lts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime, RollupOp.avg, TriageCompute.lts__t_sectors_srcunit_tex_op_atom_realtime, RollupOp.avg
            maxRate: 1.0
          description: proportion of L2 sector lookups from unit L1TEX for atomics or reductions that hit
      - TriageCompute.lts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime:
          counter:
            expr: lts__t_sectors_srcunit_tex_op_read_realtime - lts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime
            sustainedRate: 2.0
          description: "# of LTS sectors from unit L1TEX for all reads that hit"
      - TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_read_realtime:
          ratio:
            expr: TriageCompute.lts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime, RollupOp.avg, lts__t_sectors_srcunit_tex_op_read_realtime, RollupOp.avg
            maxRate: 1.0
          description: proportion of L2 sector lookups from unit L1TEX for reads that hit
      - TriageCompute.lts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime:
          counter:
            expr: lts__t_sectors_srcunit_tex_op_write_realtime - lts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime
            sustainedRate: 1.0
          description: "# of LTS sectors from unit L1TEX for all writes that hit"
      - TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_op_write_realtime:
          ratio:
            expr: TriageCompute.lts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime, RollupOp.avg, lts__t_sectors_srcunit_tex_op_write_realtime, RollupOp.avg
            maxRate: 1.0
          description: proportion of L2 sector lookups from unit L1TEX for writes that hit
      - TriageCompute.lts__throughput:
          throughput:
            - lts__lts2xbar_cycles_active_realtime
            - lts__t_requests
            - lts__t_sectors_realtime
            - lts__xbar2lts_cycles_active
            - lts__d_sectors_fill_device
            - lts__ltcfabric2lts_cycles_active
          description: LTS Throughput (TriageCompute Configuration)
      - TriageCompute.max_warps_per_sm:
          conversionFactor:
            multiplier: 32
            dimunits: DimUnit.warps
      - TriageCompute.pcie__throughput:
          throughput:
            - pcie__read_bytes
            - pcie__write_bytes
          description: PCIe Throughput TriageCompute Configuration
      - TriageCompute.sm__thread_inst_executed_pred_on:
          counter:
            expr: RerollUp(smsp__thread_inst_executed_pred_on, RollupOp.sum, HwUnit.sm)
            sustainedRate: 128.0
      - TriageCompute.sm__average_thread_inst_executed_pred_on_per_inst_executed_realtime:
          ratio:
            expr: TriageCompute.sm__thread_inst_executed_pred_on, RollupOp.avg, sm__inst_executed_realtime, RollupOp.avg
            maxRate: 32.0
          description: "average # of active predicated-on threads per instruction executed"
      - TriageCompute.sm__thread_inst_executed:
          counter:
            expr: RerollUp(smsp__thread_inst_executed, RollupOp.sum, HwUnit.sm)
            sustainedRate: 128.0
      - TriageCompute.sm__throughput:
          throughput:
            - sm__inst_executed_pipe_uniform_realtime
            - sm__pipe_xu_cycles_active_realtime
            - sm__mem_tensor_cycles_active_realtime
            - sm__pipe_aluheavy_cycles_active_realtime
            - sm__inst_executed_realtime
            - sm__pipe_fmalite_cycles_active_realtime
            - sm__pipe_fmaheavy_cycles_active_realtime
            - sm__pipe_fp64_cycles_active_realtime
            - sm__pipe_tensor_cycles_active_realtime
          description: SM Throughput (TriageCompute Configuration)
      - TriageCompute.sm__warps_inactive_sm_idle:
          counter:
            expr: (sm__cycles_elapsed - sm__cycles_active) * TriageCompute.max_warps_per_sm
            sustainedRate: 32.0
          description: "cumulative # of idle warp slots on idle SMs"
      - TriageCompute.syslts__t_sectors_aperture_peermem_realtime:
          counter:
            expr: syslts__t_sectors_realtime - syslts__t_sectors_aperture_sysmem_realtime
            sustainedRate: 1.0
          description: "# of SYSLTS sectors for the peer aperture"
      - TriageCompute.syslts__average_t_sector_aperture_peer:
          ratio:
            expr: TriageCompute.syslts__t_sectors_aperture_peermem_realtime, RollupOp.avg, syslts__t_sectors_realtime, RollupOp.avg
            maxRate: 1.0
          description: proportion of L2 sectors accessing peer memory
      - TriageCompute.syslts__average_t_sector_aperture_sysmem:
          ratio:
            expr: syslts__t_sectors_aperture_sysmem_realtime, RollupOp.avg, syslts__t_sectors_realtime, RollupOp.avg
            maxRate: 1.0
          description: proportion of L2 sectors accessing system memory
      - TriageCompute.syslts__t_sectors_srcunit_gcc_lookup_hit_realtime:
          counter:
            expr: syslts__t_sectors_srcunit_gcc_realtime - syslts__t_sectors_srcunit_gcc_lookup_miss_realtime
            sustainedRate: 1.0
          description: "# of SYSLTS sectors from unit GCC that hit"
      - TriageCompute.syslts__average_t_sector_hit_rate_srcunit_gcc_realtime:
          ratio:
            expr: TriageCompute.syslts__t_sectors_srcunit_gcc_lookup_hit_realtime, RollupOp.sum, syslts__t_sectors_srcunit_gcc_realtime, RollupOp.sum
            maxRate: 1.0
          description: proportion of SYSL2 sector lookups from unit GCC that hit
      - TriageCompute.syslts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime:
          counter:
            expr: syslts__t_sectors_srcunit_tex_op_read_realtime - syslts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime
            sustainedRate: 1.0
          description: "# of SYSLTS sectors from unit L1TEX for all reads that hit"
      - TriageCompute.syslts__average_t_sector_hit_rate_srcunit_tex_op_read_realtime:
          ratio:
            expr: TriageCompute.syslts__t_sectors_srcunit_tex_op_read_lookup_hit_realtime, RollupOp.avg, syslts__t_sectors_srcunit_tex_op_read_realtime, RollupOp.avg
            maxRate: 1.0
          description: proportion of SYSL2 sector lookups from unit L1TEX for reads that hit
      - TriageCompute.syslts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime:
          counter:
            expr: syslts__t_sectors_srcunit_tex_op_write_realtime - syslts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime
            sustainedRate: 1.0
          description: "# of SYSLTS sectors from unit L1TEX for all writes that hit"
      - TriageCompute.syslts__average_t_sector_hit_rate_srcunit_tex_op_write_realtime:
          ratio:
            expr: TriageCompute.syslts__t_sectors_srcunit_tex_op_write_lookup_hit_realtime, RollupOp.avg, syslts__t_sectors_srcunit_tex_op_write_realtime, RollupOp.avg
            maxRate: 1.0
          description: proportion of SYSL2 sector lookups from unit L1TEX for writes that hit
      - TriageCompute.syslts__t_sector_throughput_aperture_peer:
          throughput:
            - TriageCompute.syslts__t_sectors_aperture_peermem_realtime
          description: throughput of L2 sectors accessing peer memory
      - TriageCompute.syslts__t_sector_throughput_aperture_sysmem:
          throughput:
            - syslts__t_sectors_aperture_sysmem_realtime
          description: throughput of L2 sectors accessing system memory
      - TriageCompute.syslts__t_sectors_srcunit_tex_op_atom_realtime:
          counter:
            expr: syslts__t_sectors_srcunit_tex_realtime - syslts__t_sectors_srcunit_tex_op_read_realtime - syslts__t_sectors_srcunit_tex_op_write_realtime
            sustainedRate: 1.0
      - TriageCompute.syslts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime:
          counter:
            expr: (TriageCompute.syslts__t_sectors_srcunit_tex_op_atom_realtime) - (syslts__t_sectors_srcunit_tex_lookup_miss_realtime - syslts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime - syslts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime)
            sustainedRate: 1.0
          description: "# of SYSLTS sectors from unit L1TEX for all atomics or reductions that hit"
      - TriageCompute.syslts__throughput:
          throughput:
            - syslts__syslts2xbar_cycles_active
            - syslts__t_requests
            - syslts__t_sectors_realtime
            - syslts__xbar2syslts_cycles_active
          description: SYSLTS Throughput (TriageCompute Configuration)
      - TriageCompute.tpc__average_bytes_mem_untagged_data_shared_allocated_compute_per_cta_realtime:
          ratio:
            expr: tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_realtime, RollupOp.avg, tpc__ctas_active_realtime, RollupOp.avg
            maxRate: 328*2*1024
          description: average shared memory per CTA
      - TriageCompute.tpc__average_cta_latency_realtime:
          ratio:
            expr: tpc__ctas_active_realtime, RollupOp.sum, gr__ctas_launched_realtime, RollupOp.sum
            maxRate: 1.0
          description: average CTA duration (cycles)
      - TriageCompute.tpc__average_cta_user_latency_realtime:
          ratio:
            expr: tpc__ctas_active_realtime, RollupOp.sum, TriageCompute.gr_total_ctas_launched_realtime, RollupOp.sum
            maxRate: 1.0
          description: average user CTA duration (cycles)
      - TriageCompute.tpc__threads_active_shader_cs_realtime:
          counter:
            expr: tpc__warps_active_shader_cs_realtime * 32
            sustainedRate: 2048.0
      - TriageCompute.tpc__average_registers_per_thread_shader_cs_realtime:
          ratio:
            expr: tpc__sm_rf_registers_allocated_shader_cs_realtime, RollupOp.avg, TriageCompute.tpc__threads_active_shader_cs_realtime, RollupOp.avg
            maxRate: 256.0
          description: "average # of registers per thread, for CS warps"
      - TriageCompute.tpc__average_sharedmem_bytes_per_cta_realtime:
          ratio:
            expr: tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_realtime, RollupOp.avg, tpc__ctas_active_realtime, RollupOp.avg
            maxRate: 671744.0
          description: average shared memory per CTA
      - TriageCompute.tpc__average_warp_latency_shader_cs_realtime:
          ratio:
            expr: tpc__warps_active_shader_cs_realtime, RollupOp.avg, tpc__warps_launched_shader_cs, RollupOp.avg
            maxRate: 1.0
          description: average CS warp duration (cycles)
      - TriageCompute.tpc__l1tex_sram_bytes_mem_untagged_data_shared_unallocated_compute_realtime:
          counter:
            expr: tpc__l1tex_sram_bytes_mem_untagged_realtime - tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_realtime
            sustainedRate: 328*2*1024
          description: "cumulative # of shared memory bytes unallocated for compute"
      - TriageCompute.ComputeTriage_TPC.tpc__warps_active:
          counter:
            expr: tpc__warps_active_shader_cs_realtime
            sustainedRate: 64.0
          description: "cumulative # of warps in flight"
      - TriageCompute.ComputeTriage_TPC.tpc__l1tex_average_cache_bytes_per_warp:
          ratio:
            expr: tpc__l1tex_sram_bytes_mem_tagged_realtime, RollupOp.avg, TriageCompute.ComputeTriage_TPC.tpc__warps_active, RollupOp.avg
            maxRate: 336*1024
          description: average cache bytes per warp
      - TriageCompute.ComputeTriage_TPC.sm__warps_inactive_sm_active:
          counter:
            expr: sm__cycles_active * TriageCompute.max_warps_per_sm - RollDown(TriageCompute.ComputeTriage_TPC.tpc__warps_active, HwUnit.sm)
            sustainedRate: 32.0
          description: "cumulative # of idle warp slots on active SMs"
      - nsys.max_warps_per_tpc:
          conversionFactor:
            multiplier: 64
            dimunits: DimUnit.warps
      - nsys.gr__compute_cycles_active:
          counter:
            expr: FMax(gr__compute_cycles_active_queue_sync, gr__compute_cycles_active_queue_async)
            sustainedRate: 1.0
          description: "# of cycles with compute in flight"
      - nsys.tpc__warps_inactive_sm_active:
          counter:
            expr: RerollUp(sm__cycles_active, RollupOp.avg, HwUnit.tpc) * nsys.max_warps_per_tpc - TriageCompute.ComputeTriage_TPC.tpc__warps_active
            sustainedRate: 64.0
          description: "cumulative # of idle warp slots on active SMs"
      - nsys.syslts__average_t_sector_hit_rate_aperture_peermem:
          ratio:
            expr: syslts__t_sectors_aperture_peermem_lookup_hit_realtime, RollupOp.sum, TriageCompute.syslts__t_sectors_aperture_peermem_realtime, RollupOp.sum
            maxRate: 1.0
          description: proportion of SysL2 peermem sector lookups that hit
      - nsys.syslts__average_t_sector_hit_rate_aperture_sysmem:
          ratio:
            expr: syslts__t_sectors_aperture_sysmem_lookup_hit_realtime, RollupOp.sum, syslts__t_sectors_aperture_sysmem_realtime, RollupOp.sum
            maxRate: 1.0
          description: proportion of SysL2 sysmem sector lookups that hit
      - nsys.sm__pipe_fma_cycles_active_realtime:
          counter:
            expr: sm__pipe_fmalite_cycles_active_realtime + sm__pipe_fmaheavy_cycles_active_realtime
      - nsys.nvltx__bytes_data_protocol:
          counter:
            expr: nvltx__bytes - nvltx__bytes_data_user
            sustainedRate: 1.0
          description: "# of bytes of NVLTX overhead data, at 32B granularity"
      - nsys.nvlrx__bytes_data_protocol:
          counter:
            expr: nvlrx__bytes - nvlrx__bytes_data_user
            sustainedRate: 1.0
          description: "# of bytes of NVLRX overhead data, at 32B granularity"
      - TriageCompute.syslts__average_t_sector_hit_rate_srcunit_tex_op_atom_realtime:
          ratio:
            expr: TriageCompute.syslts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime, RollupOp.avg, TriageCompute.syslts__t_sectors_srcunit_tex_op_atom_realtime, RollupOp.avg
            maxRate: 1.0
          description: proportion of SYSL2 sector lookups from unit L1TEX for atomics or reductions that hit
    metrics:
      - name: Compute Pipe Active
        id: nsys.gr__compute_cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Cycles
            suffix: .sum
        color: orange
      - name: PCIe Throughput
        id: TriageCompute.pcie__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        shortName: PCIe
        color: "#3577F3"
      - name: DRAM Total Bandwidth
        id: dram__sectors
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
            multiplier: 32
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 3.2000000000000002e-08
        color: "#CC6666"
      - name: SysL2 Throughput
        id: TriageCompute.syslts__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        shortName: SysL2
        color: cyan
      - name: VidL2 Throughput
        id: TriageCompute.lts__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        shortName: VidL2
        color: "#00AEDB"
      - name: SM Throughput
        id: TriageCompute.sm__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        shortName: SM
        color: "#D100EE"
      - name: L1TEX Throughput
        id: TriageCompute.l1tex__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        shortName: L1TEX
        color: "#B6D900"
      - name: PCIe RX Bandwidth
        id: pcie__read_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 1.0000000000000001e-09
        color: khaki
      - name: PCIe TX Bandwidth
        id: pcie__write_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 1.0000000000000001e-09
        color: darkkhaki
      - name: NVLink RX Bandwidth
        id: nvlrx__bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 1.0000000000000001e-09
        color: dodgerblue
      - name: NVLink TX Bandwidth
        id: nvltx__bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 1.0000000000000001e-09
        color: indianred
      - name: DRAM Read Bandwidth
        id: dram__sectors_op_read
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
            multiplier: 32
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 3.2000000000000002e-08
        color: "#CCCC00"
      - name: DRAM Write Bandwidth
        id: dram__sectors_op_write
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
            multiplier: 32
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 3.2000000000000002e-08
        color: "#CC00CC"
      - name: SysL2 Total Memory Bandwidth
        id: syslts__t_sectors_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
            multiplier: 32
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 3.2000000000000002e-08
        color: deepskyblue
      - name: SysL2 Request Active
        id: syslts__t_sectors_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: deepskyblue
      - name: SysL2-to-XBAR Active
        id: syslts__syslts2xbar_cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#3577F3"
      - name: XBAR-to-SysL2 Active
        id: syslts__xbar2syslts_cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: blue
      - name: SysL2 Request Stage Active
        id: syslts__t_requests
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: cyan
      - name: SysL2 Atomic Stage Active
        id: syslts__d_atomic_input_cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: lightsteelblue
      - name: VidL2 Sectors
        id: lts__t_sectors_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
            multiplier: 32
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 3.2000000000000002e-08
        color: paleturquoise
      - name: VidL2-to-XBAR Active
        id: lts__lts2xbar_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: deepskyblue
      - name: XBAR-to-VidL2 Active
        id: lts__xbar2lts_cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: cyan
      - name: VidL2 Request Active
        id: lts__t_requests
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: blue
      - name: VidL2 Atomic Stage Active
        id: lts__d_atomic_input_cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: lightsteelblue
      - name: L1TEX LSU Data-Stage Throughput
        id: TriageCompute.l1tex__data_pipe_lsu_wavefronts
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
            multiplier: 128
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 1.2800000000000001e-07
        color: dodgerblue
      - name: L1TEX LSU Writeback-Stage Throughput
        id: l1tex__lsu_writeback_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: green
      - name: L1TEX TC Data-Stage Throughput
        id: l1tex__data_pipe_tc_wavefronts
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Bytes
            suffix: .sum
            multiplier: 128
          - name: GB/s
            suffix: .sum.per_second
            multiplier: 1.2800000000000001e-07
        color: "#662DCC"
      - name: XBAR-to-L1TEX Read Sectors
        id: l1tex__m_xbar2l1tex_read_sectors_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: red
      - name: XBAR-to-L1TEX DSMEM Read Sectors
        id: l1tex__m_xbar2l1tex_read_sectors_mem_dshared
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: blue
      - name: L1TEX-to-XBAR Requests Active
        id: l1tex__m_l1tex2xbar_req_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: teal
      - name: L1TEX-to-XBAR DSMEM Requests Active
        id: l1tex__m_l1tex2xbar_req_cycles_active_mem_dshared
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: gold
      - name: L1TEX-to-XBAR TMA Requests Active
        id: l1tex__m_l1tex2xbar_req_cycles_active_op_tma
        subMetrics:
          - name: Throughput %
