            maxRate: 1.0
          description: proportion of SYSL2 sector lookups from unit GCC that hit
      - Top_Level_Overview.syslts__t_sectors_srcunit_pe_op_read_lookup_hit_realtime:
          counter:
            expr: syslts__t_sectors_srcunit_pe_op_read_realtime - syslts__t_sectors_srcunit_pe_op_read_lookup_miss_realtime
      - Top_Level_Overview.syslts__average_t_sector_hit_rate_srcunit_pe_op_read_realtime:
          ratio:
