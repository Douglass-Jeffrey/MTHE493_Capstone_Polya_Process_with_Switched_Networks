        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Shared Memory Usage
        metrics:
          - Shared Memory Available for Compute
          - Shared Memory Allocated for Compute
        subMetrics:
          - Bytes
        aggregationOp: max
      - name: Register Quanta Allocated by Active CS Warps
        metrics:
          - Register Quanta Allocated by Active CS Warps
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Registers per Thread
        metrics:
          - SM Registers per Thread
        subMetrics:
          - Registers
        aggregationOp: max
      - name: SM Thread Blocks Active
        metrics:
          - SM Thread Blocks Active
          - SM Thread Blocks Launched
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Thread Block Average Duration
        metrics:
          - SM Thread Block Average Duration
        subMetrics:
          - Cycles
        aggregationOp: max
      - name: SM Thread Block Average Shared Memory
        metrics:
          - SM Thread Block Average Shared Memory
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: SM Warp Launched CS
        metrics:
          - SM Warp Launched CS
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Thread Block Clusters
        metrics:
          - Clusters Active
          - Clusters Launched
          - Clusters Completed
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 Throughputs
        metrics:
          - L1 Throughput
          - L1 LSU Data-Stage Throughput
          - L1 Local+Global+Distributed Shared Data-Stage Throughput
          - L1 Shared+Attribute Data-Stage Throughput
          - L1 LSU Writeback-Stage Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 M-Stage XBAR
        metrics:
          - L1 M-Stage to XBAR Active
          - L1 M-Stage to XBAR Active (Distributed Shared)
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 M-Stage Sectors Read
        metrics:
          - L1 M-Stage Sectors Read
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 Sector Hit Rate
        metrics:
          - L1 Sector Hit Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: L1 Sector Requests
        metrics:
          - L1 Sector Requests
          - L1 Sector Requests Hit
          - L1 Sector Requests Missed
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L2 Bandwidths
        metrics:
          - L2 Bandwidth to Device Memory
          - L2 Bandwidth to System/Peer Memory
          - L2 Bandwidth from FBP
          - L2 Bandwidth from GPC
          - L2 Bandwidth from HUB
          - L2 Bandwidth from GCC
          - L2 Bandwidth from TEX
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L2 Allocation
        metrics:
          - L2 Sector Hit Rate
          - L2 Sector Hit Rate from L1
          - L2 Sectors from FBP
          - L2 Sectors from GPC
          - L2 Sectors from HUB
          - L2 Sectors from GCC
          - L2 Sectors from TEX
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: DRAM Bandwidth
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: CTC RX Throughput
        metrics:
          - CTC RX Throughput Protocol Data
          - CTC RX Throughput User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: CTC TX Throughput
        metrics:
          - CTC TX Throughput Protocol Data
          - CTC TX Throughput User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: PCIe Bandwidth
        metrics:
          - PCIe Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe RX Bandwidth
        metrics:
          - PCIe RX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe TX Bandwidth
        metrics:
          - PCIe TX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: NVLink RX Bandwidth
        metrics:
          - NVLink RX Requests Protocol Data
          - NVLink RX Requests User Data
          - NVLink RX Responses Protocol Data
          - NVLink RX Responses User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: NVLink TX Bandwidth
        metrics:
          - NVLink TX Requests Protocol Data
          - NVLink TX Requests User Data
          - NVLink TX Responses Protocol Data
          - NVLink TX Responses User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
    timelineViews:
      - name: Default
        rows:
          - metricGroup: $root:Activity
            heightScale: 0.5
          - metricGroup: $root:Memory
            heightScale: -0.5
          - GR Active
          - GR Kernel Launch
          - GR Context Switches
          - FE Active
          - Async Compute Queue
          - Compute Active
          - SMs Active
          - SM Throughput
          - SM Thread Instructions Executed
          - SM Warp Stalls
          - SM Instruction Throughputs
          - SM Warp Occupancy
          - SM Shared Memory Usage
          - Register Quanta Allocated by Active CS Warps
          - SM Registers per Thread
          - SM Thread Blocks Active
          - SM Thread Block Average Duration
          - SM Thread Block Average Shared Memory
          - SM Warp Launched CS
          - Thread Block Clusters
          - L1 Throughputs
          - L1 M-Stage XBAR
          - L1 M-Stage Sectors Read
          - L1 Sector Hit Rate
          - L1 Sector Requests
          - L2 Bandwidths
          - L2 Allocation
          - metricGroup: DRAM Bandwidth
          - metricGroup: CTC RX Throughput
          - metricGroup: CTC TX Throughput
          - PCIe Bandwidth
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
          - metricGroup: NVLink RX Bandwidth
          - metricGroup: NVLink TX Bandwidth
  - name: General Metrics for NVIDIA GB20x
    alias: gb20x
    chips:
      - GB202
      - GB203
      - GB205
      - GB206
      - GB207
    setSpecifier: Default
    metrics:
      - name: GPC Clock Frequency
        id: gpc__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the GPC graphics clock. In NVIDIA GPU Specs this is the Boost Clock and Base Clock. In nvidia-smi this is the "gr", "graphics", "Graphics Clock".
        color: "#8BDDB4"
      - name: SYS Clock Frequency
        id: sys__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the SYS clock. The SYS clock is the clock used for the copy engines, compute and graphics command processor, and the hardware performance monitor streaming unit.
        color: "#118E44"
      - name: Sync Copy Engine Active
        id: gpu__engine_cycles_active_any_syncce
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Cycles Active
            suffix: .sum
        color: "#B2B233"
      - name: Async Copy Engine Active 0
        id: gpu__scheduler_engine_asyncce0_cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Cycles Active
            suffix: .sum
        color: "#FFA700"
      - name: GR Active
        id: gr__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .sum.pct_of_peak_sustained_elapsed
        description: Number of cycles the graphics/compute engine is active. The graphics and compute engine are active if there is any work in the graphics pipe or if the compute pipe is processing a dispatch.
        color: "#ED6A32"
      - name: SMs Active
        id: sm__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles SMs had at least 1 warp in flight to the number of cycles
        color: "#FFA5A5"
      - name: SM Issue
        id: sm__inst_executed_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: SM instruction issue rate. Each SM can issue 4 instructions/cycle (1 instruction/SMSP/cycle).
        color: "#98C4DD"
      - name: Tensor Active
        id: sm__pipe_tensor_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles the tensor pipe is active
        color: "#76B900"
      - name: Vertex/Tess/Geometry Warps in Flight
        id: tpc__warps_active_shader_vtg_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
            multiplier: 0.5
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
            multiplier: 0.5
        description: Total number of graphics vertex, tessellation, geometry, and mesh shader warps in flight
        color: "#FFA5A5"
      - name: Pixel Warps in Flight
        id: tpc__warps_active_shader_ps_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
            multiplier: 0.5
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
            multiplier: 0.5
        description: Total number of pixel shader warps in flight
        color: "#8BDDB4"
      - name: Compute Warps in Flight
        id: tpc__warps_active_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
            multiplier: 0.5
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
            multiplier: 0.5
        description: Total number of compute shader warps in flight
        color: "#FFD179"
      - name: DRAM Read Bandwidth
        id: dram__read_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active reading data to the elapsed cycles in the same period as a percentage
        color: "#FFA5A5"
      - name: DRAM Write Bandwidth
        id: dram__write_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active writing data to the elapsed cycles in the same period as a percentage
        color: "#98C4DD"
      - name: PCIe RX Throughput
        id: pcie__read_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes received by GPU (includes protocol)
        color: "#FF3D00"
      - name: PCIe TX Throughput
        id: pcie__write_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes transmitted by GPU (includes protocol)
        color: "#00CFCF"
      - name: PCIe Read Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_read
        subMetrics:
          - name: Requests
            suffix: .sum
        description: CPU+Peer Reads from VRAM over PCIe
        color: "#87FFFF"
      - name: PCIe Write Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_write
        subMetrics:
          - name: Requests
            suffix: .sum
        description: CPU+Peer Writes to VRAM over PCIe
        color: "#8700FF"
    metricGroups:
      - name: $root:Activity
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: $root:Memory
        metrics:
          - PCIe RX Throughput
          - PCIe TX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GPC Clock Frequency
        metrics:
          - GPC Clock Frequency
        subMetrics:
          - MHz
        aggregationOp: max
      - name: SYS Clock Frequency
        metrics:
          - SYS Clock Frequency
        subMetrics:
          - MHz
        aggregationOp: max
      - name: GPU Active
        description: The graphics or copy engine is active
        metrics:
          - Sync Copy Engine Active
          - Async Copy Engine Active 0
          - GR Active
        subMetrics:
          - Throughput %
          - Cycles Active
        aggregationOp: max
      - name: SMs Active
        metrics:
          - SMs Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Instructions
        metrics:
          - SM Issue
          - Tensor Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Warp Occupancy
        metrics:
          - Vertex/Tess/Geometry Warps in Flight
          - Pixel Warps in Flight
          - Compute Warps in Flight
        subMetrics:
          - Throughput %
          - Avg
          - Avg Warps per Cycle
        aggregationOp: sum
      - name: DRAM Bandwidth
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: PCIe RX Bandwidth
        metrics:
          - PCIe RX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe TX Bandwidth
        metrics:
          - PCIe TX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe Read Requests to BAR1
        metrics:
          - PCIe Read Requests to BAR1
        subMetrics:
          - Requests
        aggregationOp: max
      - name: PCIe Write Requests to BAR1
        metrics:
          - PCIe Write Requests to BAR1
        subMetrics:
          - Requests
        aggregationOp: max
    timelineViews:
      - name: Default
        rows:
          - metricGroup: $root:Activity
            heightScale: 0.5
          - metricGroup: $root:Memory
            heightScale: -0.5
          - GPC Clock Frequency
          - SYS Clock Frequency
          - GPU Active
          - SMs Active
          - SM Instructions
          - metricGroup: SM Warp Occupancy
            heightScale: 3
          - metricGroup: DRAM Bandwidth
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
          - PCIe Read Requests to BAR1
          - PCIe Write Requests to BAR1
  - name: Top-Level Overview Metrics for NVIDIA GB20x
    alias: gb20x-top
    chips:
      - GB202
      - GB203
      - GB205
      - GB206
      - GB207
    setSpecifier: Default
    customMetricDefinitions:
      - Top_Level_Overview.ScreenPipe_throughput:
          throughput:
            - prop__prop2crop_pixels_realtime
            - rop__throughput
            - prop__prop2sm_pixels_mode_earlyz
            - prop__prop2zrop_pixels_realtime
            - prop__prop2sm_pixels_mode_latez
            - stri__throughput
      - Top_Level_Overview.WorldPipe_throughput:
          throughput:
            - pda__input_verts_realtime
            - pda__input_prims_realtime
            - vaf__throughput_realtime
            - tpc__vaf2mio_phase_alpha_cycles_active
            - tpc__vaf2mio_phase_beta_cycles_active
      - Top_Level_Overview.bytes_per_l1tex_line:
          conversionFactor:
            multiplier: 128
            dimunits: DimUnit.bytes / DimUnit.l1tex_lines
      - Top_Level_Overview.l1data_bank_conflicts_to_l1tex_wavefronts_conversion_factor:
          conversionFactor:
            multiplier: 1
            dimunits: DimUnit.l1tex_wavefronts / DimUnit.l1data_bank_conflicts
      - Top_Level_Overview.tpc__warps_active_realtime:
          counter:
            expr: tpc__warps_active_shader_vtg_realtime + tpc__warps_active_shader_ps_realtime + tpc__warps_active_shader_cs_queue_sync_realtime + tpc__warps_active_shader_cs_queue_async_realtime
            sustainedRate: 96.0
      - Top_Level_Overview.l1tex__average_cache_bytes_per_warp:
          ratio:
            expr: tpc__l1tex_sram_bytes_mem_tagged_realtime, RollupOp.avg, Top_Level_Overview.tpc__warps_active_realtime, RollupOp.avg
            maxRate: 128*1024
      - Top_Level_Overview.l1tex_data_bytes_per_wavefronts:
          conversionFactor:
            multiplier: 128
            dimunits: DimUnit.bytes / DimUnit.l1tex_wavefronts
      - Top_Level_Overview.l1tex__data_pipe_lsu_bytes_mem_shared:
          counter:
            expr: l1tex__data_pipe_lsu_wavefronts_mem_shared * Top_Level_Overview.l1tex_data_bytes_per_wavefronts
            sustainedRate: 128.0
      - Top_Level_Overview.l1tex__data_pipe_lsu_wavefronts_mem_surface:
          counter:
            expr: l1tex__data_pipe_lsu_wavefronts - l1tex__data_pipe_lsu_wavefronts_mem_lgds - l1tex__data_pipe_lsu_wavefronts_mem_shared
            sustainedRate: 1.0
      - Top_Level_Overview.l1tex__throughput:
          throughput:
            - l1tex__sram_cycles_array_0_cmd_read
            - l1tex__sram_cycles_array_0_cmd_write
            - l1tex__sram_cycles_array_1_cmd_read
            - l1tex__sram_cycles_array_1_cmd_write
            - l1tex__data_pipe_lsu_wavefronts
            - l1tex__lsu_writeback_active
            - l1tex__data_pipe_tex_wavefronts
            - l1tex__f_wavefronts_realtime
            - l1tex__tex_writeback_active
            - l1tex__m_xbar2l1tex_read_sectors_realtime
            - l1tex__samp_wavefronts
            - tpc__l1tex_m_l1tex2xbar_req_cycles_active
      - Top_Level_Overview.lts__cbc_requests_type_comptag_realtime:
          counter:
            expr: lts__cbc_requests_type_comptag_lookup_hit_realtime + lts__cbc_requests_type_comptag_lookup_miss_or_hit_to_miss_realtime
            sustainedRate: 1.0
          description: "# of compressible requests handled by CBC"
      - Top_Level_Overview.lts__average_cbc_hit_rate_realtime:
          ratio:
            expr: lts__cbc_requests_type_comptag_lookup_hit_realtime, RollupOp.sum, Top_Level_Overview.lts__cbc_requests_type_comptag_realtime, RollupOp.sum
            maxRate: 1.0
          description: proportion of requests that hit in CBC
      - Top_Level_Overview.lts__t_sectors_srcnode_gpc_lookup_hit_realtime:
          counter:
            expr: lts__t_sectors_srcnode_gpc_realtime - lts__t_sectors_srcnode_gpc_lookup_miss_realtime
            sustainedRate: 2.0
          description: "# of LTS sectors from node GPC that hit"
      - Top_Level_Overview.lts__average_t_sector_hit_rate_srcnode_gpc_realtime:
