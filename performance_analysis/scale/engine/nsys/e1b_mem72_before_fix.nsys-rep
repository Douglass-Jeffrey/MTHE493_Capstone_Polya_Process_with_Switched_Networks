            maxValueSuffix: .avg.peak_sustained
            multiplier: 4
          - name: Occupancy %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: gray
      - name: Stalled on Long Scoreboard
        id: smsp__warps_issue_stalled_long_scoreboard
        subMetrics:
          - name: Warps/SM
            suffix: .avg.per_cycle_elapsed
            maxValueSuffix: .avg.peak_sustained
            multiplier: 4
          - name: Occupancy %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#8673A1"
      - name: Predicated-on Active Threads per Warp
        id: TriageCompute.sm__average_thread_inst_executed_pred_on_per_inst_executed_realtime
        subMetrics:
          - name: Threads/Warp
            suffix: .ratio
            maxValueSuffix: .max_rate
          - name: Coherence
            suffix: .pct
        color: green
      - name: SM Tensor Memory Throughtput
        id: sm__mem_tensor_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#662DCC"
      - name: SM Thread Block Tensor Memory
        id: sm__mem_tensor_bytes_allocated
        subMetrics:
          - name: Bytes/SM
            suffix: .avg.per_cycle_elapsed
            maxValueSuffix: .avg.peak_sustained
        color: "#662DCC"
      - name: SM Avg Thread Block Shared Memory
        id: TriageCompute.tpc__average_sharedmem_bytes_per_cta_realtime
        subMetrics:
          - name: kB
            suffix: .ratio
            maxValueSuffix: .max_rate
            multiplier: 0.001
        color: orange
      - name: SM Avg Registers per Thread
        id: TriageCompute.tpc__average_registers_per_thread_shader_cs_realtime
        subMetrics:
          - name: Registers
            suffix: .ratio
        color: orange
      - name: Thread Block Clusters Launched
        id: gpc__cgas_launched
        subMetrics:
          - name: Clusters
            suffix: .sum
        color: darkorange
      - name: Thread Block Clusters Active
        id: gpc__cgas_active_realtime
        subMetrics:
          - name: Clusters
            suffix: .sum
        color: gold
      - name: Thread Block Clusters Completed
        id: gpc__cgas_completed
        subMetrics:
          - name: Clusters
            suffix: .sum
        color: silver
      - name: SM Warps Active
        id: TriageCompute.ComputeTriage_TPC.tpc__warps_active
        subMetrics:
          - name: Warps/SM
            suffix: .avg.per_cycle_elapsed
            maxValueSuffix: .avg.peak_sustained
            multiplier: 0.5
          - name: Occupancy %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: orange
      - name: Unallocated Warps in Active SMs
        id: nsys.tpc__warps_inactive_sm_active
        subMetrics:
          - name: Warps/SM
            suffix: .avg.per_cycle_elapsed
            maxValueSuffix: .avg.peak_sustained
            multiplier: 0.5
          - name: Occupancy %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#696969"
      - name: CS Register Allocation
        id: tpc__sm_rf_registers_allocated_shader_cs_realtime
        subMetrics:
          - name: Occupancy %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Registers/SM
            suffix: .avg.per_cycle_elapsed
            multiplier: 0.5
        color: orange
      - name: SM Thread Blocks Allocated
        id: tpc__ctas_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg Blocks/SM
            suffix: .avg.per_cycle_elapsed
            multiplier: 0.5
        color: "#B23333"
      - name: SM Shared Memory Allocated
        id: tpc__l1tex_sram_bytes_mem_untagged_data_shared_allocated_compute_realtime
        subMetrics:
          - name: Bytes/SM
            suffix: .avg.per_cycle_elapsed
            maxValueSuffix: .avg.peak_sustained
            multiplier: 0.5
        color: orange
      - name: SM Shared Memory Unallocated
        id: TriageCompute.tpc__l1tex_sram_bytes_mem_untagged_data_shared_unallocated_compute_realtime
        subMetrics:
          - name: Bytes/SM
            suffix: .avg.per_cycle_elapsed
            maxValueSuffix: .avg.peak_sustained
            multiplier: 0.5
        color: gray
      - name: SM Tagged Memory
        id: tpc__l1tex_sram_bytes_mem_tagged_realtime
        subMetrics:
          - name: Bytes/SM
            suffix: .avg.per_cycle_elapsed
            maxValueSuffix: .avg.peak_sustained
            multiplier: 0.5
        color: orchid
      - name: SM Avg L1TEX Cache Bytes per Warp
        id: TriageCompute.ComputeTriage_TPC.tpc__l1tex_average_cache_bytes_per_warp
        subMetrics:
          - name: kB
            suffix: .ratio
            maxValueSuffix: .max_rate
            multiplier: 0.001
        color: orange
      - name: GPC Frequency
        id: gpc__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
          - name: Cycles
            suffix: .avg
        color: olive
      - name: SYS Frequency
        id: sys__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
          - name: Cycles
            suffix: .avg
        color: limegreen
      - name: VidL2 Frequency
        id: lts__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
          - name: Cycles
            suffix: .avg
        color: cyan
      - name: DRAM Frequency
        id: dram__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
          - name: Cycles
            suffix: .avg
        color: brown
