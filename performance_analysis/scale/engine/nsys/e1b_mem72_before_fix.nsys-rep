            sustainedRate: 1.0
          description: "# of SYSLTS sectors from unit PE that hit"
      - Top_Level_Overview.syslts__average_t_sector_hit_rate_srcunit_pe_realtime:
          ratio:
            expr: Top_Level_Overview.syslts__t_sectors_srcunit_pe_lookup_hit_realtime, RollupOp.sum, syslts__t_sectors_srcunit_pe_realtime, RollupOp.sum
            maxRate: 1.0
          description: proportion of SYSL2 sector lookups from unit PE that hit
      - Top_Level_Overview.syslts__t_sectors_srcunit_raster_lookup_hit_realtime:
          counter:
            expr: syslts__t_sectors_srcunit_raster_realtime - syslts__t_sectors_srcunit_raster_lookup_miss_realtime
            sustainedRate: 1.0
          description: "# of SYSLTS sectors from unit RASTER that hit"
      - Top_Level_Overview.syslts__average_t_sector_hit_rate_srcunit_raster_realtime:
          ratio:
            expr: Top_Level_Overview.syslts__t_sectors_srcunit_raster_lookup_hit_realtime, RollupOp.sum, syslts__t_sectors_srcunit_raster_realtime, RollupOp.sum
            maxRate: 1.0
          description: proportion of SYSL2 sector lookups from unit RASTER that hit
      - Top_Level_Overview.syslts__t_sectors_srcunit_tex_op_atom_realtime:
          counter:
            expr: syslts__t_sectors_srcunit_tex_realtime - syslts__t_sectors_srcunit_tex_op_read_realtime - syslts__t_sectors_srcunit_tex_op_write_realtime
      - Top_Level_Overview.syslts__t_sectors_srcunit_tex_op_atom_lookup_hit_realtime:
          counter:
            expr: (Top_Level_Overview.syslts__t_sectors_srcunit_tex_op_atom_realtime) - (syslts__t_sectors_srcunit_tex_lookup_miss_realtime - syslts__t_sectors_srcunit_tex_op_read_lookup_miss_realtime - syslts__t_sectors_srcunit_tex_op_write_lookup_miss_realtime)
            sustainedRate: 1.0
          description: "# of SYSLTS sectors from unit L1TEX for all atomics or reductions that hit"
      - Top_Level_Overview.syslts__average_t_sector_hit_rate_srcunit_tex_op_atom_realtime:
