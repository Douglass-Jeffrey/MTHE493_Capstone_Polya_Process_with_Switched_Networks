metricSets:
  - name: General Metrics for NVIDIA TU10x
    alias: tu10x
    chips:
      - TU102
      - TU104
      - TU106
    setSpecifier: Default
    metrics:
      - name: GPC Clock Frequency
        id: gpc__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the GPC graphics clock. In NVIDIA GPU Specs this is the Boost Clock and Base Clock. In nvidia-smi this is the "gr", "graphics", "Graphics Clock".
        color: "#8BDDB4"
      - name: SYS Clock Frequency
        id: sys__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the SYS clock. The SYS clock is the clock used for the copy engines, compute and graphics command processor, and the hardware performance monitor streaming unit.
        color: "#118E44"
      - name: GR Active
        id: gr__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of cycles the graphics/compute engine is active. The graphics and compute engine are active if there is any work in the graphics pipe or if the compute pipe is processing a dispatch.
        color: "#ED6A32"
      - name: Sync Compute in Flight
        id: HUB.TriageA.gr__dispatch_cycles_active_queue_sync
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FE7F9C"
      - name: Async Compute in Flight
        id: HUB.TriageA.gr__dispatch_cycles_active_queue_async
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FFD179"
      - name: Draw Started
        id: FE_A.TriageA.fe__draw_count
        subMetrics:
          - name: Workloads
            suffix: .sum
        description: Number of draw calls started
        color: "#F0F000"
      - name: Dispatch Started
        id: HUB.TriageA.gr__dispatch_count
        subMetrics:
          - name: Workloads
            suffix: .sum
        description: Number of compute dispatches/grid launches started
        color: "#00F0F0"
      - name: SMs Active
        id: sm__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles SMs had at least 1 warp in flight to the number of cycles
        color: "#FFA5A5"
      - name: SM Issue
        id: SM.TriageA.sm__inst_executed_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: SM instruction issue rate. Each SM can issue 4 instructions/cycle (1 instruction/SMSP/cycle).
        color: "#98C4DD"
      - name: Tensor Active / FP16 Active
        id: SM.TriageA.sm__pipe_shared_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles the tensor pipe or fp16x2 pipe is active
        color: "#B3FF70"
      - name: Vertex/Tess/Geometry Warps in Flight
        id: TPC.TriageA.tpc__warps_active_shader_vtg_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of graphics vertex, tessellation, geometry, and mesh shader warps in flight
        color: "#FFA5A5"
      - name: Pixel Warps in Flight
        id: TPC.TriageA.tpc__warps_active_shader_ps_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of pixel shader warps in flight
        color: "#8BDDB4"
      - name: Compute Warps in Flight
        id: TPC.TriageA.tpc__warps_active_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of compute shader warps in flight
        color: "#FFD179"
      - name: Unallocated Warps in Active SMs
        id: TPC.TriageA.tpc__warps_inactive_sm_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
        description: Total number of warp slots available on active SMs
        color: "#696969"
      - name: DRAM Read Bandwidth
        id: dramc__read_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active reading data to the elapsed cycles in the same period as a percentage
        color: "#FFA5A5"
      - name: DRAM Write Bandwidth
        id: dramc__write_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active writing data to the elapsed cycles in the same period as a percentage
        color: "#98C4DD"
      - name: NVLink RX Requests Protocol Data
        id: nvlrx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX request protocol data
        color: "#C79536"
      - name: NVLink RX Requests User Data
        id: nvlrx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX request user data
        color: "#FFD179"
      - name: NVLink RX Responses Protocol Data
        id: nvlrx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX response protocol data
        color: "#C25D5D"
      - name: NVLink RX Responses User Data
        id: nvlrx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX response user data
        color: "#FFA5A5"
      - name: NVLink TX Requests Protocol Data
        id: nvltx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX request protocol data
        color: "#9052BF"
      - name: NVLink TX Requests User Data
        id: nvltx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX request user data
        color: "#D6A4FC"
      - name: NVLink TX Responses Protocol Data
        id: nvltx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX response protocol data
        color: "#6999B5"
      - name: NVLink TX Responses User Data
        id: nvltx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX response user data
        color: "#98C4DD"
      - name: PCIe RX Throughput
        id: PCI.TriageA.pcie__read_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes received by GPU (includes protocol)
        color: "#FF3D00"
      - name: PCIe TX Throughput
        id: PCI.TriageA.pcie__write_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes transmitted by GPU (includes protocol)
        color: "#00CFCF"
      - name: PCIe Read Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_read
        subMetrics:
          - name: Requests
            suffix: .sum
        description: CPU+Peer Reads from VRAM over PCIe
        color: "#87FFFF"
      - name: PCIe Write Requests to BAR1
        id: pcie__rx_requests_aperture_bar1_op_write
        subMetrics:
          - name: Requests
            suffix: .sum
        description: CPU+Peer Writes to VRAM over PCIe
        color: "#8700FF"
    metricGroups:
      - name: $root:Activity
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: $root:Memory
        metrics:
          - NVLink RX Responses User Data
          - NVLink TX Responses User Data
          - PCIe RX Throughput
          - PCIe TX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GPC Clock Frequency
        metrics:
          - GPC Clock Frequency
        subMetrics:
          - MHz
        aggregationOp: max
      - name: SYS Clock Frequency
        metrics:
          - SYS Clock Frequency
        subMetrics:
          - MHz
        aggregationOp: max
      - name: GPU Active
        description: The graphics or copy engine is active
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Compute in Flight
        description: Compute dispatches sent to the GPU queues that have been issued, but not yet complete
        metrics:
          - Sync Compute in Flight
          - Async Compute in Flight
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Draw/Dispatch Start
        description: Draw and dispatch start times
        metrics:
          - Draw Started
          - Dispatch Started
        subMetrics:
          - Workloads
        aggregationOp: max
      - name: SMs Active
        metrics:
          - SMs Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Instructions
        metrics:
          - SM Issue
          - Tensor Active / FP16 Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Warp Occupancy
        metrics:
          - Vertex/Tess/Geometry Warps in Flight
          - Pixel Warps in Flight
          - Compute Warps in Flight
          - Unallocated Warps in Active SMs
        subMetrics:
          - Throughput %
          - Avg
          - Avg Warps per Cycle
        aggregationOp: sum
      - name: DRAM Bandwidth
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: NVLink RX Bandwidth
        metrics:
          - NVLink RX Requests Protocol Data
          - NVLink RX Requests User Data
          - NVLink RX Responses Protocol Data
          - NVLink RX Responses User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: NVLink TX Bandwidth
        metrics:
          - NVLink TX Requests Protocol Data
          - NVLink TX Requests User Data
          - NVLink TX Responses Protocol Data
          - NVLink TX Responses User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: PCIe RX Bandwidth
        metrics:
          - PCIe RX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe TX Bandwidth
        metrics:
          - PCIe TX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe Read Requests to BAR1
        metrics:
          - PCIe Read Requests to BAR1
        subMetrics:
          - Requests
        aggregationOp: max
      - name: PCIe Write Requests to BAR1
        metrics:
          - PCIe Write Requests to BAR1
        subMetrics:
          - Requests
        aggregationOp: max
    timelineViews:
      - name: Default
        rows:
          - metricGroup: $root:Activity
            heightScale: 0.5
          - metricGroup: $root:Memory
            heightScale: -0.5
          - GPC Clock Frequency
          - SYS Clock Frequency
          - GPU Active
          - Compute in Flight
          - Draw/Dispatch Start
          - SMs Active
          - SM Instructions
          - metricGroup: SM Warp Occupancy
            heightScale: 3
          - metricGroup: DRAM Bandwidth
          - metricGroup: NVLink RX Bandwidth
          - metricGroup: NVLink TX Bandwidth
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
          - PCIe Read Requests to BAR1
          - PCIe Write Requests to BAR1
  - name: General Metrics for NVIDIA TU11x
    alias: tu11x
    chips:
      - TU116
      - TU117
    setSpecifier: Default
    metrics:
      - name: GPC Clock Frequency
        id: gpc__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the GPC graphics clock. In NVIDIA GPU Specs this is the Boost Clock and Base Clock. In nvidia-smi this is the "gr", "graphics", "Graphics Clock".
        color: "#8BDDB4"
