        description: Number of bytes of NVLRX response user data
        color: "#FFA5A5"
      - name: NVLink TX Requests Protocol Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX request protocol data
        color: "#9052BF"
      - name: NVLink TX Requests User Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX request user data
        color: "#D6A4FC"
      - name: NVLink TX Responses Protocol Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX response protocol data
        color: "#6999B5"
      - name: NVLink TX Responses User Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX response user data
        color: "#98C4DD"
    schedulingHints:
      - domain: gpu_sm_b
        counters:
          - 0x429f51824686c32f
          - 0x5405725d0bccb9f2
          - 0xc83feae1569676cb
          - 0xf4f29376cc3d2819
      - domain: gpu_sm_c
        counters:
          - 0x072dfe5865d3d982
          - 0x3388ca3182975dbc
          - 0x7f3ce2c9a5d9e8f8
          - 0xff12a10aead6b65b
    metricGroups:
      - name: $root:Activity
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: $root:Memory
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GR Active
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GR Kernel Launch
        metrics:
          - GR Kernel Launch
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GR Context Switches
        metrics:
          - GR Context Switches
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: FE Active
        metrics:
          - FE Active
          - FE Stalled
          - FE Output Ops
          - FE Go Idle
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Async Compute Queue
        metrics:
          - Semaphore Releases Async
          - Semaphore Acquire Stalled Async
          - WFI Stalled Async
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Compute Active
        metrics:
          - Async Compute Active
          - Sync Compute Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SMs Active
        metrics:
          - SMs Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Throughput
        metrics:
          - SM Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Thread Instructions Executed
        metrics:
          - SM Thread Instructions Executed
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Warp Stalls
        metrics:
          - SM Warps Stalled on L1 Operation
          - SM Warps Stalled on MIO Operation
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Instruction Throughputs
        metrics:
          - SM Issue Active
          - SM ALU Pipe Throughput
          - SM FMA Pipe Throughput
          - SM FMA Light Pipe Throughput
          - SM FMA Heavy Pipe Throughput
          - SM Uniform Pipe Throughput
          - SM XU Pipe Throughput
          - SM FP64 Pipe Active
          - SM Tensor Pipe Active
          - SM Tensor Pipe Active FP64
          - SM Tensor Pipe Active (HMMA ops)
          - SM Tensor Pipe Active (IMMA ops)
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Warp Occupancy
        metrics:
          - SM Warps Active CS
          - Active SM Unused Warp Slots
          - Idle SM Unused Warp Slots
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Shared Memory Usage
        metrics:
          - Shared Memory Available for Compute
          - Shared Memory Allocated for Compute
        subMetrics:
          - Bytes
        aggregationOp: max
      - name: Register Quanta Allocated by Active CS Warps
        metrics:
          - Register Quanta Allocated by Active CS Warps
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Registers per Thread
        metrics:
          - SM Registers per Thread
        subMetrics:
          - Registers
        aggregationOp: max
      - name: SM Thread Blocks Active
        metrics:
          - SM Thread Blocks Active
          - SM Thread Blocks Launched
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Thread Block Average Duration
        metrics:
          - SM Thread Block Average Duration
        subMetrics:
          - Cycles
        aggregationOp: max
      - name: SM Thread Block Average Shared Memory
        metrics:
          - SM Thread Block Average Shared Memory
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: SM Warp Launched CS
        metrics:
          - SM Warp Launched CS
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Thread Block Clusters
        metrics:
          - Clusters Active
          - Clusters Launched
          - Clusters Completed
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 Throughputs
        metrics:
          - L1 Throughput
          - L1 LSU Data-Stage Throughput
          - L1 Local+Global+Distributed Shared Data-Stage Throughput
          - L1 Shared+Attribute Data-Stage Throughput
          - L1 LSU Writeback-Stage Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 M-Stage XBAR
        metrics:
          - L1 M-Stage to XBAR Active
          - L1 M-Stage to XBAR Active (Distributed Shared)
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 M-Stage Sectors Read
        metrics:
          - L1 M-Stage Sectors Read
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L1 Sector Hit Rate
        metrics:
          - L1 Sector Hit Rate
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: L1 Sector Requests
        metrics:
          - L1 Sector Requests
          - L1 Sector Requests Hit
          - L1 Sector Requests Missed
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L2 Bandwidths
        metrics:
          - L2 Bandwidth to Device Memory
          - L2 Bandwidth to System/Peer Memory
          - L2 Bandwidth from FBP
          - L2 Bandwidth from GPC
          - L2 Bandwidth from HUB
          - L2 Bandwidth from GCC
          - L2 Bandwidth from TEX
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: L2 Allocation
        metrics:
          - L2 Sector Hit Rate
          - L2 Sector Hit Rate from L1
          - L2 Sectors from FBP
          - L2 Sectors from GPC
          - L2 Sectors from HUB
          - L2 Sectors from GCC
          - L2 Sectors from TEX
        subMetrics:
          - Ratio %
        aggregationOp: max
      - name: DRAM Bandwidth
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: CTC RX Throughput
        metrics:
          - CTC RX Throughput Protocol Data
          - CTC RX Throughput User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: CTC TX Throughput
        metrics:
          - CTC TX Throughput Protocol Data
          - CTC TX Throughput User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: PCIe Bandwidth
        metrics:
          - PCIe Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe RX Bandwidth
        metrics:
          - PCIe RX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe TX Bandwidth
        metrics:
          - PCIe TX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: NVLink RX Bandwidth
        metrics:
          - NVLink RX Requests Protocol Data
          - NVLink RX Requests User Data
          - NVLink RX Responses Protocol Data
          - NVLink RX Responses User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: NVLink TX Bandwidth
        metrics:
          - NVLink TX Requests Protocol Data
          - NVLink TX Requests User Data
          - NVLink TX Responses Protocol Data
          - NVLink TX Responses User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
    timelineViews:
      - name: Default
        rows:
          - metricGroup: $root:Activity
            heightScale: 0.5
          - metricGroup: $root:Memory
            heightScale: -0.5
          - GR Active
          - GR Kernel Launch
          - GR Context Switches
          - FE Active
          - Async Compute Queue
          - Compute Active
          - SMs Active
          - SM Throughput
          - SM Thread Instructions Executed
          - SM Warp Stalls
          - SM Instruction Throughputs
          - SM Warp Occupancy
          - SM Shared Memory Usage
          - Register Quanta Allocated by Active CS Warps
          - SM Registers per Thread
          - SM Thread Blocks Active
          - SM Thread Block Average Duration
          - SM Thread Block Average Shared Memory
          - SM Warp Launched CS
          - Thread Block Clusters
          - L1 Throughputs
          - L1 M-Stage XBAR
          - L1 M-Stage Sectors Read
          - L1 Sector Hit Rate
          - L1 Sector Requests
          - L2 Bandwidths
          - L2 Allocation
          - metricGroup: DRAM Bandwidth
          - metricGroup: CTC RX Throughput
          - metricGroup: CTC TX Throughput
          - PCIe Bandwidth
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
          - metricGroup: NVLink RX Bandwidth
          - metricGroup: NVLink TX Bandwidth
  - name: General Metrics for NVIDIA GB11x
    alias: gb11x
    chips:
      - GB110
      - GB112
    setSpecifier: Default
    metrics:
      - name: GPC Clock Frequency
        id: gpc__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the GPC graphics clock. In NVIDIA GPU Specs this is the Boost Clock and Base Clock. In nvidia-smi this is the "gr", "graphics", "Graphics Clock".
        color: "#8BDDB4"
      - name: SYS Clock Frequency
        id: sys__cycles_elapsed
        subMetrics:
          - name: MHz
            suffix: .avg.per_second
            multiplier: 9.9999999999999995e-07
        description: The frequency of the SYS clock. The SYS clock is the clock used for the copy engines, compute and graphics command processor, and the hardware performance monitor streaming unit.
        color: "#118E44"
      - name: GR Active
        id: gr__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .sum.pct_of_peak_sustained_elapsed
        description: Number of cycles the graphics/compute engine is active. The graphics and compute engine are active if there is any work in the graphics pipe or if the compute pipe is processing a dispatch.
        color: "#ED6A32"
      - name: SMs Active
        id: sm__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles SMs had at least 1 warp in flight to the number of cycles
        color: "#FFA5A5"
      - name: SM Issue
        id: sm__inst_executed_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: SM instruction issue rate. Each SM can issue 4 instructions/cycle (1 instruction/SMSP/cycle).
        color: "#98C4DD"
      - name: Tensor Active
        id: sm__pipe_tensor_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles the tensor pipe is active
        color: "#76B900"
      - name: Compute Warps in Flight
        id: TPC.TriageCompute.tpc__warps_active_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
          - name: Avg
            suffix: .avg
            multiplier: 0.5
          - name: Avg Warps per Cycle
            suffix: .avg.per_cycle_elapsed
            multiplier: 0.5
        description: Total number of compute shader warps in flight
        color: "#FFD179"
      - name: DRAM Read Bandwidth
        id: dram__read_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active reading data to the elapsed cycles in the same period as a percentage
        color: "#FFA5A5"
      - name: DRAM Write Bandwidth
        id: dram__write_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active writing data to the elapsed cycles in the same period as a percentage
        color: "#98C4DD"
      - name: NVLink RX Requests Protocol Data
        id: NVLRX.TriageCompute.nvlrx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX request protocol data
        color: "#C79536"
      - name: NVLink RX Requests User Data
        id: NVLRX.TriageCompute.nvlrx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX request user data
        color: "#FFD179"
      - name: NVLink RX Responses Protocol Data
        id: NVLRX.TriageCompute.nvlrx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX response protocol data
        color: "#C25D5D"
      - name: NVLink RX Responses User Data
        id: NVLRX.TriageCompute.nvlrx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX response user data
        color: "#FFA5A5"
      - name: NVLink TX Requests Protocol Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX request protocol data
        color: "#9052BF"
      - name: NVLink TX Requests User Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX request user data
        color: "#D6A4FC"
      - name: NVLink TX Responses Protocol Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX response protocol data
        color: "#6999B5"
      - name: NVLink TX Responses User Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX response user data
        color: "#98C4DD"
      - name: CTC RX Throughput Protocol Data
        id: CTC_B.TriageCompute.ctc__rx_bytes_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#C79536"
      - name: CTC RX Throughput User Data
        id: CTC_B.TriageCompute.ctc__rx_bytes_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FFD179"
      - name: CTC TX Throughput Protocol Data
        id: CTC_A.TriageCompute.ctc__tx_bytes_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#9052BF"
      - name: CTC TX Throughput User Data
        id: CTC_A.TriageCompute.ctc__tx_bytes_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D6A4FC"
      - name: PCIe RX Throughput
        id: PCI.TriageCompute.pcie__read_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes received by GPU (includes protocol)
        color: "#FF3D00"
      - name: PCIe TX Throughput
        id: PCI.TriageCompute.pcie__write_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes transmitted by GPU (includes protocol)
        color: "#00CFCF"
    metricGroups:
      - name: $root:Activity
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: $root:Memory
        metrics:
          - NVLink RX Responses User Data
          - NVLink TX Responses User Data
          - PCIe RX Throughput
          - PCIe TX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GPC Clock Frequency
        metrics:
          - GPC Clock Frequency
        subMetrics:
          - MHz
        aggregationOp: max
      - name: SYS Clock Frequency
        metrics:
          - SYS Clock Frequency
        subMetrics:
          - MHz
        aggregationOp: max
      - name: GPU Active
        description: The graphics or copy engine is active
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SMs Active
        metrics:
          - SMs Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Instructions
        metrics:
          - SM Issue
          - Tensor Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Warp Occupancy
        metrics:
          - Compute Warps in Flight
        subMetrics:
          - Throughput %
          - Avg
          - Avg Warps per Cycle
        aggregationOp: sum
      - name: DRAM Bandwidth
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: NVLink RX Bandwidth
        metrics:
          - NVLink RX Requests Protocol Data
          - NVLink RX Requests User Data
          - NVLink RX Responses Protocol Data
          - NVLink RX Responses User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: NVLink TX Bandwidth
        metrics:
          - NVLink TX Requests Protocol Data
          - NVLink TX Requests User Data
          - NVLink TX Responses Protocol Data
          - NVLink TX Responses User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: CTC RX Throughput
        metrics:
          - CTC RX Throughput Protocol Data
          - CTC RX Throughput User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: CTC TX Throughput
        metrics:
          - CTC TX Throughput Protocol Data
          - CTC TX Throughput User Data
        subMetrics:
          - Throughput %
        aggregationOp: sum
      - name: PCIe RX Bandwidth
        metrics:
          - PCIe RX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: PCIe TX Bandwidth
        metrics:
          - PCIe TX Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
    timelineViews:
      - name: Default
        rows:
          - metricGroup: $root:Activity
            heightScale: 0.5
          - metricGroup: $root:Memory
            heightScale: -0.5
          - GPC Clock Frequency
          - SYS Clock Frequency
          - GPU Active
          - SMs Active
          - SM Instructions
          - metricGroup: SM Warp Occupancy
          - metricGroup: DRAM Bandwidth
          - metricGroup: NVLink RX Bandwidth
          - metricGroup: NVLink TX Bandwidth
          - metricGroup: CTC RX Throughput
          - metricGroup: CTC TX Throughput
          - PCIe RX Bandwidth
          - PCIe TX Bandwidth
  - name: Compute Triage Metrics for NVIDIA GB110/GB11x
    alias: gb11x-ct
    chips:
      - GB110
      - GB112
    setSpecifier: Default
    metrics:
      - name: GR Active
        id: FE_B.TriageCompute.gr__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where GR was active
        color: "#ED6A32"
      - name: GR Kernel Launch
        id: FE_A.TriageCompute.gr__dispatch_count
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Compute dispatches sent to GR
        color: "#ED6A32"
      - name: GR Context Switches
        id: FE_A.TriageCompute.gpu__gr_cycles_active_cmd_ctxsw
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where GR performed a context switch
        color: LightCoral
      - name: FE Active
        id: FE_B.TriageCompute.fe__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where FE was active
        color: DarkOrange
      - name: FE Stalled
        id: FE_A.TriageCompute.fe__cycles_stalled_cmd_wfi
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where FE was stalled on wait-for-idle
        color: DarkKhaki
      - name: FE Output Ops
        id: FE_B.TriageCompute.fe__output_ops
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Operations sent by FE
        color: LightSalmon
      - name: FE Go Idle
        id: FE_B.TriageCompute.fe__output_ops_cmd_go_idle
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: GO_IDLE bundles sent to GR from FE
        color: Gold
      - name: Semaphore Releases Async
        id: FE_A.TriageCompute.gpu__scheduler_engine_gr_queue_async_cmd_semreleases
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Semaphore releases issued by any async compute queue
        color: Turquoise
      - name: Semaphore Acquire Stalled Async
        id: gpu__scheduler_engine_gr_queue_async_cycles_stalled_cmd_semacquire
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where any async compute queue was stalled on a semaphore acquire
        color: CadetBlue
      - name: WFI Stalled Async
        id: FE_A.TriageCompute.gpu__scheduler_engine_gr_queue_async_cycles_stalled_cmd_wfi
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where any async compute queue was stalled on wait-for-idle
        color: LightSteelBlue
      - name: Async Compute Active
        id: FE_A.TriageCompute.gr__compute_cycles_active_queue_async
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles with asynchronous compute in flight
        color: PaleTurquoise
      - name: Sync Compute Active
        id: FE_A.TriageCompute.gr__compute_cycles_active_queue_sync
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles with synchronous compute in flight
        color: DarkSeaGreen
      - name: SMs Active
        id: TPC.TriageCompute.sm__cycles_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles with at least one warp in flight
        color: Tomato
      - name: SM Throughput
        id: TriageCompute.sm__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: Thistle
      - name: SM Thread Instructions Executed
        id: sm__thread_inst_executed_pred_on_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: Turquoise
      - name: SM Warps Stalled on L1 Operation
        id: SM_C.TriageCompute.smsp__warps_issue_stalled_long_scoreboard
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Warps waiting for a scoreboard dependency on L1TEX (local, global, surface, tex) operation
        color: Olive
      - name: SM Warps Stalled on MIO Operation
        id: SM_C.TriageCompute.smsp__warps_issue_stalled_short_scoreboard
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Warps waiting for a scoreboard dependency on MIO operation other than (local, global, surface, tex)
        color: DarkSeaGreen
      - name: SM Issue Active
        id: TPC.TriageCompute.sm__inst_executed_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Warp instructions executed
        color: "#CFCF3F"
      - name: SM ALU Pipe Throughput
        id: TPC.TriageCompute.sm__inst_executed_pipe_alu_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Warp instructions executed by ALU Pipe
        color: "#FF6F00"
      - name: SM FMA Pipe Throughput
        id: TPC.TriageCompute.sm__pipe_fma_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where FMA Pipe was active
        color: "#00CF3F"
      - name: SM FMA Light Pipe Throughput
        id: TPC.TriageCompute.sm__inst_executed_pipe_fmalite_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Warp instructions executed by FMA Lite Pipe
        color: "#00CF00"
      - name: SM FMA Heavy Pipe Throughput
        id: TPC.TriageCompute.sm__pipe_fmaheavy_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where FMA Heavy Pipe was active
        color: "#CF003F"
      - name: SM Uniform Pipe Throughput
        id: SM_A.TriageCompute.sm__inst_executed_pipe_uniform_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Warp instructions executed by Uniform Pipe
        color: "#CF3F00"
      - name: SM XU Pipe Throughput
        id: SM_A.TriageCompute.sm__pipe_xu_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where XU Pipe was active
        color: "#00003F"
      - name: SM Tensor Pipe Active
        id: TPC.TriageCompute.sm__pipe_tensor_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where Tensor Pipe was active
        color: LightSteelBlue
      - name: SM Tensor Pipe Active (HMMA ops)
        id: TPC.TriageCompute.sm__pipe_tensor_subpipe_hmma_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where Tensor Pipe was active (HMMA ops)
        color: DeepSkyBlue
      - name: SM Tensor Pipe Active (IMMA ops)
        id: TPC.TriageCompute.sm__pipe_tensor_subpipe_imma_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where Tensor Pipe was active (IMMA ops)
        color: DarkTurquoise
      - name: SM Warps Active CS
        id: TPC.TriageCompute.tpc__warps_active_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: PaleGreen
      - name: Active SM Unused Warp Slots
        id: TPC.TriageCompute.tpc__warps_inactive_sm_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Idle warp slots on active SMs
        color: OliveDrab
      - name: Idle SM Unused Warp Slots
        id: TPC.TriageCompute.tpc__warps_inactive_sm_idle_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Idle warp slots on idle SMs
        color: lavender
      - name: Shared Memory Available for Compute
        id: TPC.TriageCompute.tpc__l1tex_mem_shared_data_compute_kilobytes_configured_realtime
        subMetrics:
          - name: Bytes
            suffix: .sum
            multiplier: 1000
        color: Olive
      - name: Shared Memory Allocated for Compute
        id: TPC.TriageCompute.tpc__l1tex_mem_shared_data_compute_lines_allocated_realtime
        subMetrics:
          - name: Bytes
            suffix: .sum
            multiplier: 128
        color: BurlyWood
      - name: Register Quanta Allocated by Active CS Warps
        id: TPC.TriageCompute.tpc__sm_rf_quanta_allocated_shader_cs_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: SteelBlue
      - name: SM Registers per Thread
        id: TPC.TriageCompute.tpc__average_registers_per_thread_shader_cs_realtime
        subMetrics:
          - name: Registers
            suffix: .ratio
        color: CadetBlue
      - name: SM Thread Blocks Active
        id: sm__ctas_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: SkyBlue
      - name: SM Thread Blocks Launched
        id: FE_B.TriageCompute.gr__ctas_launched_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: LimeGreen
      - name: SM Thread Block Average Duration
        id: TriageCompute.tpc__average_cta_latency_realtime
        subMetrics:
          - name: Cycles
            suffix: .ratio
        color: BlueViolet
      - name: SM Thread Block Average Shared Memory
        id: TPC.TriageCompute.tpc__average_sharedmem_bytes_per_cta_realtime
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: MediumSeaGreen
      - name: SM Warp Launched CS
        id: TPC.TriageCompute.tpc__warps_launched_shader_cs
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: LightGreen
      - name: Clusters Active
        id: GPC_B.TriageCompute.gpc__cgas_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#DD4444"
      - name: Clusters Launched
        id: GPC_B.TriageCompute.gpc__cgas_launched
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#4444DD"
      - name: Clusters Completed
        id: GPC_B.TriageCompute.gpc__cgas_completed
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#44DD44"
      - name: L1 Throughput
        id: SM_A.TriageCompute.l1tex__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#3F0000"
      - name: L1 LSU Data-Stage Throughput
        id: SM_A.TriageCompute.l1tex__data_pipe_lsu_wavefronts
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Local/global/shared/(distributed shared) + surface write wavefronts processed by Data-Stage
        color: "#CFCF3F"
      - name: L1 Local+Global+Distributed Shared Data-Stage Throughput
        id: SM_A.TriageCompute.l1tex__data_pipe_lsu_wavefronts_mem_lgds
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Local/global/(distributed shared) wavefronts processed by Data-Stage
        color: "#FF6F00"
      - name: L1 Shared+Attribute Data-Stage Throughput
        id: SM_A.TriageCompute.l1tex__data_pipe_lsu_wavefronts_mem_shared
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Shared memory wavefronts processed by Data-Stage for LDS, LD, 3D attribute loads, LDSM, STS, ST, ATOMS, ATOM, 3D attribute stores, STSM, LDGSTS, HGMMA, IGMMA, BGMMA, QGMMA and Misc
        color: "#00CF00"
      - name: L1 LSU Writeback-Stage Throughput
        id: SM_A.TriageCompute.l1tex__lsu_writeback_active
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where local/global/shared/(distributed shared) writeback interface was active except GMMA instructions
        color: "#CF003F"
      - name: L1 M-Stage to XBAR Active
        id: SM_A.TriageCompute.l1tex__m_l1tex2xbar_req_cycles_active_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where interface from L1TEX M-Stage to XBAR was active
        color: MediumPurple
      - name: L1 M-Stage to XBAR Active (Distributed Shared)
        id: l1tex__m_l1tex2xbar_req_cycles_active_mem_dshared
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Cycles where interface from L1TEX M-Stage to XBAR was active for distributed shared
        color: Indigo
      - name: L1 M-Stage Sectors Read
        id: SM_A.TriageCompute.l1tex__m_xbar2l1tex_read_sectors_realtime
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Sectors read into L1TEX M-Stage
        color: Orchid
      - name: L1 Sector Hit Rate
        id: SM_B.TriageCompute.l1tex__t_sector_hit_rate
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: Tan
      - name: L1 Sector Requests
        id: SM_B.TriageCompute.l1tex__t_sectors
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: Goldenrod
      - name: L1 Sector Requests Hit
        id: SM_B.TriageCompute.l1tex__t_sectors_lookup_hit
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Sector requests to T-Stage with tag-hit and data-hit
        color: SandyBrown
      - name: L1 Sector Requests Missed
        id: SM_B.TriageCompute.l1tex__t_sectors_lookup_miss
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Sector requests to T-Stage that missed
        color: Brown
      - name: L2 Bandwidth to Device Memory
        id: LTS.TriageCompute.lts__t_sector_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#44DD44"
      - name: L2 Bandwidth to System/Peer Memory
        id: SYSLTS.TriageCompute.syslts__t_sector_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#4444DD"
      - name: L2 Bandwidth from FBP
        id: LTS.TriageCompute.lts__t_sector_throughput_srcnode_fbp
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#111111"
      - name: L2 Bandwidth from GPC
        id: LTS.TriageCompute.lts__t_sector_throughput_srcnode_gpc
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#11AA11"
      - name: L2 Bandwidth from HUB
        id: LTS.TriageCompute.lts__t_sector_throughput_srcnode_hub
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#AAAAAA"
      - name: L2 Bandwidth from GCC
        id: LTS.TriageCompute.lts__t_sector_throughput_srcunit_gcc
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#11AAAA"
      - name: L2 Bandwidth from TEX
        id: LTS.TriageCompute.lts__t_sector_throughput_srcunit_tex
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#AAAA11"
      - name: L2 Sector Hit Rate
        id: LTS.TriageCompute.lts__average_t_sector_hit_rate_realtime
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: "#AA4444"
      - name: L2 Sector Hit Rate from L1
        id: LTS.TriageCompute.lts__average_t_sector_hit_rate_srcunit_tex_realtime
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: "#AA4400"
      - name: L2 Sectors from FBP
        id: LTS.TriageCompute.lts__average_t_sector_srcnode_fbp
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: "#111111"
      - name: L2 Sectors from GPC
        id: LTS.TriageCompute.lts__average_t_sector_srcnode_gpc
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: "#11AA11"
      - name: L2 Sectors from HUB
        id: LTS.TriageCompute.lts__average_t_sector_srcnode_hub
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: "#AAAAAA"
      - name: L2 Sectors from GCC
        id: LTS.TriageCompute.lts__average_t_sector_srcunit_gcc
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: "#11AAAA"
      - name: L2 Sectors from TEX
        id: LTS.TriageCompute.lts__average_t_sector_srcunit_tex
        subMetrics:
          - name: Ratio %
            suffix: .pct
        color: "#AAAA11"
      - name: DRAM Read Bandwidth
        id: dram__read_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active reading data to the elapsed cycles in the same period as a percentage
        color: "#FFA5A5"
      - name: DRAM Write Bandwidth
        id: dram__write_throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: The ratio of cycles the DRAM interface was active writing data to the elapsed cycles in the same period as a percentage
        color: "#98C4DD"
      - name: CTC RX Throughput Protocol Data
        id: CTC_B.TriageCompute.ctc__rx_bytes_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#C79536"
      - name: CTC RX Throughput User Data
        id: CTC_B.TriageCompute.ctc__rx_bytes_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#FFD179"
      - name: CTC TX Throughput Protocol Data
        id: CTC_A.TriageCompute.ctc__tx_bytes_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#9052BF"
      - name: CTC TX Throughput User Data
        id: CTC_A.TriageCompute.ctc__tx_bytes_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: "#D6A4FC"
      - name: PCIe Bandwidth
        id: PCI.TriageCompute.pcie__throughput
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        color: Green
      - name: PCIe RX Throughput
        id: PCI.TriageCompute.pcie__read_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes received by GPU (includes protocol)
        color: "#FF3D00"
      - name: PCIe TX Throughput
        id: PCI.TriageCompute.pcie__write_bytes
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes transmitted by GPU (includes protocol)
        color: "#00CFCF"
      - name: NVLink RX Requests Protocol Data
        id: NVLRX.TriageCompute.nvlrx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX request protocol data
        color: "#C79536"
      - name: NVLink RX Requests User Data
        id: NVLRX.TriageCompute.nvlrx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX request user data
        color: "#FFD179"
      - name: NVLink RX Responses Protocol Data
        id: NVLRX.TriageCompute.nvlrx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX response protocol data
        color: "#C25D5D"
      - name: NVLink RX Responses User Data
        id: NVLRX.TriageCompute.nvlrx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLRX response user data
        color: "#FFA5A5"
      - name: NVLink TX Requests Protocol Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_request_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX request protocol data
        color: "#9052BF"
      - name: NVLink TX Requests User Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_request_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX request user data
        color: "#D6A4FC"
      - name: NVLink TX Responses Protocol Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_response_data_protocol
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX response protocol data
        color: "#6999B5"
      - name: NVLink TX Responses User Data
        id: NVLTX.TriageCompute.nvltx__bytes_packet_response_data_user
        subMetrics:
          - name: Throughput %
            suffix: .avg.pct_of_peak_sustained_elapsed
        description: Number of bytes of NVLTX response user data
        color: "#98C4DD"
    schedulingHints:
      - domain: gpu_sm_b
        counters:
          - 0x429f51824686c32f
          - 0x5405725d0bccb9f2
          - 0xc83feae1569676cb
          - 0xf4f29376cc3d2819
      - domain: gpu_sm_c
        counters:
          - 0x072dfe5865d3d982
          - 0x3388ca3182975dbc
          - 0x7f3ce2c9a5d9e8f8
          - 0xff12a10aead6b65b
    metricGroups:
      - name: $root:Activity
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: $root:Memory
        metrics:
          - DRAM Read Bandwidth
          - DRAM Write Bandwidth
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GR Active
        metrics:
          - GR Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GR Kernel Launch
        metrics:
          - GR Kernel Launch
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: GR Context Switches
        metrics:
          - GR Context Switches
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: FE Active
        metrics:
          - FE Active
          - FE Stalled
          - FE Output Ops
          - FE Go Idle
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Async Compute Queue
        metrics:
          - Semaphore Releases Async
          - Semaphore Acquire Stalled Async
          - WFI Stalled Async
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: Compute Active
        metrics:
          - Async Compute Active
          - Sync Compute Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SMs Active
        metrics:
          - SMs Active
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Throughput
        metrics:
          - SM Throughput
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Thread Instructions Executed
        metrics:
          - SM Thread Instructions Executed
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Warp Stalls
        metrics:
          - SM Warps Stalled on L1 Operation
          - SM Warps Stalled on MIO Operation
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Instruction Throughputs
        metrics:
          - SM Issue Active
          - SM ALU Pipe Throughput
          - SM FMA Pipe Throughput
          - SM FMA Light Pipe Throughput
          - SM FMA Heavy Pipe Throughput
          - SM Uniform Pipe Throughput
          - SM XU Pipe Throughput
          - SM Tensor Pipe Active
          - SM Tensor Pipe Active (HMMA ops)
          - SM Tensor Pipe Active (IMMA ops)
        subMetrics:
          - Throughput %
        aggregationOp: max
      - name: SM Warp Occupancy
